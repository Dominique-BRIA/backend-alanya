// ===============================================================
// Facturation des entreprises
// ===============================================================
// Volet sans risque du référentiel équipe (schéma du 05/08/2026) : que des
// créations. Migration : `prisma/manual/2026-08_facturation.sql`.

enum FactureStatut {
  BROUILLON // calculée, pas encore transmise au Super Admin
  ENVOYEE // transmise, en attente de justificatif validé
  PAYEE // justificatif validé
}

enum JustificatifStatut {
  EN_ATTENTE
  VALIDE
  REJETE
}

/// Comptes techniques de la facturation — à ne pas confondre avec
/// [AdminRoot], qui administre les entreprises. `type` : 0 lecture,
/// 1 lecture/écriture, 2 comptable.
model Root {
  idRoot   Int    @id @default(autoincrement()) @map("idRoot")
  username String @unique @db.VarChar(50)
  password String @db.VarChar(255)
  type     Int    @default(0) @db.SmallInt
  actif    Int    @default(1) @db.SmallInt

  FacturesCreees       Facture[]
  JustificatifsEnvoyes JustificatifPaiement[] @relation("JustifUploadeurRoot")
  JustificatifsValides JustificatifPaiement[] @relation("JustifValidateur")
}

/// Facture annuelle d'une entreprise.
///
/// `companyLibelle` est une COPIE du nom au moment de l'émission, et non une
/// jointure : une facture doit rester lisible telle qu'elle a été émise, même
/// si l'entreprise est renommée ensuite. Même raison pour les libellés de
/// lignes et leurs prix.
model Facture {
  idFacture      Int     @id @default(autoincrement())
  numero         String  @unique @db.VarChar(30)
  idCompany      Int
  /// RESTRICT et non Cascade : supprimer une entreprise ne doit pas effacer
  /// son historique comptable.
  company        Company @relation(fields: [idCompany], references: [idCompany], onDelete: Restrict)
  companyLibelle String  @db.VarChar(60)

  idSuperAdmin Int?
  superAdmin   AdminRoot? @relation(fields: [idSuperAdmin], references: [idRoot], onDelete: SetNull)

  createdByRootId Int?
  createdByRoot   Root? @relation(fields: [createdByRootId], references: [idRoot], onDelete: SetNull)

  annee        Int
  periodeDebut DateTime @db.Date
  periodeFin   DateTime @db.Date

  nombreAgents       Int
  nombreCentresAppel Int
  aNumeroCourt       Boolean

  montantTotal Decimal       @db.Decimal(12, 2)
  statut       FactureStatut @default(BROUILLON)

  createdAt DateTime  @default(now()) @db.Timestamptz
  envoyeeAt DateTime? @db.Timestamptz
  payeeAt   DateTime? @db.Timestamptz

  lignes        FactureLigne[]
  justificatifs JustificatifPaiement[]

  @@index([idCompany, annee], map: "facture_company_annee_idx")
  @@index([idSuperAdmin], map: "facture_superadmin_idx")
  @@map("facture")
}

/// Ligne de facture. `type` : 0 agent, 1 centre d'appel, 2 numéro court.
model FactureLigne {
  idLigne   Int     @id @default(autoincrement())
  idFacture Int
  facture   Facture @relation(fields: [idFacture], references: [idFacture], onDelete: Cascade)

  idPrixAbonnement Int?
  prixAbonnement   PrixAbonnement? @relation(fields: [idPrixAbonnement], references: [idAbonnement], onDelete: SetNull)
  libelleSnapshot  String          @db.VarChar(100)
  type             Int             @db.SmallInt

  quantite     Int
  prixUnitaire Decimal @db.Decimal(10, 2)
  montantLigne Decimal @db.Decimal(12, 2)

  @@index([idFacture], map: "facture_ligne_facture_idx")
  @@map("facture_ligne")
}

/// Justificatif de paiement d'une facture.
///
/// Deux dépositaires possibles — un administrateur d'entreprise ou un compte
/// technique — d'où deux clés étrangères distinctes plutôt qu'une colonne
/// unique dont on ne saurait pas quelle table elle désigne.
model JustificatifPaiement {
  idJustificatif Int     @id @default(autoincrement())
  idFacture      Int
  facture        Facture @relation(fields: [idFacture], references: [idFacture], onDelete: Cascade)

  fichierUrl String @db.VarChar(255)

  uploadedByAdminRootId Int?
  uploadedByAdminRoot   AdminRoot? @relation("JustifUploadeurAdminRoot", fields: [uploadedByAdminRootId], references: [idRoot], onDelete: SetNull)
  uploadedByRootId      Int?
  uploadedByRoot        Root?      @relation("JustifUploadeurRoot", fields: [uploadedByRootId], references: [idRoot], onDelete: SetNull)

  statut            JustificatifStatut @default(EN_ATTENTE)
  raisonRejet       String?            @db.Text
  validatedByRootId Int?
  validatedByRoot   Root?              @relation("JustifValidateur", fields: [validatedByRootId], references: [idRoot], onDelete: SetNull)
  validatedAt       DateTime?          @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([idFacture], map: "justificatif_facture_idx")
  @@map("justificatif_paiement")
}

// ---------------------------------------------------------------------------
// ESPACE DÉVELOPPEUR & API BILLING (MESSAGES X & MINUTES Y)
// ---------------------------------------------------------------------------

enum ApiKeyType {
  SANDBOX
  LIVE
}

enum TransactionType {
  PURCHASE      // Achat/Recharge de crédits
  MESSAGE_SENT  // Consommation message API
  CALL_MINUTE   // Consommation minute d'appel API
  HOLD_RESERVE  // Réservation d'appel WebRTC (5 min)
  REFUND        // Remboursement / Ajustement
}

enum TransactionStatus {
  PENDING
  SETTLED
  CANCELLED
}

/// Compte Développeur Tiers
model DeveloperAccount {
  id             String   @id @default(uuid()) @map("developer_id") @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String?  @map("company_name") @db.VarChar(100)
  /// 🔴 PLUS UTILISÉES depuis le 21/08/2026 — la facturation a été supprimée
  /// (l'API sert la plateforme de l'équipe, qui gère son propre paiement).
  /// Aucune route ne les lit ni ne les écrit ; les valeurs en base sont figées
  /// à ce qu'elles valaient. ⚠️ NON SUPPRIMÉES DE LA BASE À DESSEIN : elle est
  /// partagée avec un second système, et un DROP COLUMN casserait ses lectures.
  /// Ne pas les recâbler sans en reparler.
  balanceCredits BigInt   @default(1000) @map("balance_credits")
  holdCredits    BigInt   @default(0) @map("hold_credits")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  apiKeys    ApiKey[]
  ledger     DevLedger[]
  workspaces DeveloperWorkspace[]
  logs       DeveloperApiLog[]
  webhooks   DeveloperWebhook?
  otps       DeveloperOtp[]
  medias     DeveloperMedia[]
  /// Codes de vérification — remplace [otps], voir [Verification].
  verifications Verification[]

  @@map("developer_accounts")
}

/// Un code de vérification : double authentification, création d'agent, etc.
///
/// 🔴 REMPLACE [DeveloperOtp], qui ne pouvait pas garder un second facteur —
/// code stocké en clair, aucun compteur de tentatives, aucune finalité, aucun
/// état de livraison. Les quatre manques sont comblés ici, et les bornes sont
/// portées par des CHECK en base plutôt que par le code : deux systèmes
/// écrivent dans cette base, et une garantie qui ne vit que dans notre code ne
/// protège plus que la moitié des écritures.
///
/// ⚠️ Le code brut n'est JAMAIS stocké. Seule son empreinte SHA-256, salée par
/// ligne — sans sel, un code à six chiffres se retrouve instantanément, son
/// espace ne comptant qu'un million d'entrées.
///
/// La politique (durée, nombre d'essais, plafonds d'émission) n'est pas ici :
/// elle vit dans `src/lib/verification/politique.mjs`, sans dépendance, donc
/// exécutable et vérifiable.
model Verification {
  id          String           @id @default(uuid()) @map("id_verification") @db.Uuid
  developerId String           @map("developer_id") @db.Uuid
  developer   DeveloperAccount @relation(fields: [developerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// `AUTH_2FA`, `CREATION_AGENT`, `VALIDATION_CONTACT` — chacune a SA politique.
  finalite    String   @db.VarChar(30)
  /// `ALANYA` ou `EMAIL`. **Nous livrons dans les deux cas** : le code brut ne
  /// figure dans aucune réponse d'API. Un canal « délégué », où l'appelant
  /// aurait livré lui-même, a été écarté — il suffisait que son relais
  /// journalise les réponses pour publier tous les codes.
  canal       String   @db.VarChar(20)
  destination String   @db.VarChar(120)

  codeEmpreinte String @map("code_empreinte") @db.Char(64)
  codeSel       String @map("code_sel") @db.Char(32)

  tentatives    Int @default(0) @db.SmallInt
  maxTentatives Int @map("max_tentatives") @db.SmallInt

  expireA   DateTime  @map("expire_a") @db.Timestamptz
  /// Renseignée à la première présentation réussie — c'est l'usage unique.
  consommeA DateTime? @map("consomme_a") @db.Timestamptz

  /// Ce qui s'est RÉELLEMENT passé à la remise, jamais supposé : la route
  /// annonçait « envoyé avec succès » alors que rien ne partait.
  livraison       String  @default("EN_ATTENTE") @db.VarChar(20)
  livraisonDetail String? @map("livraison_detail") @db.VarChar(255)

  /// Source de la demande, pour le plafond par IP. Nullable : un appel
  /// serveur à serveur derrière un relais peut ne pas en fournir.
  ipDemande String?  @map("ip_demande") @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([destination, createdAt(sort: Desc)], map: "verification_destination_date_idx")
  @@index([ipDemande, createdAt(sort: Desc)], map: "verification_ip_date_idx")
  @@index([developerId, createdAt(sort: Desc)], map: "verification_developer_date_idx")
  @@map("verification")
}

/// Workspace / Projet Développeur (Multi-Projets)
model DeveloperWorkspace {
  id          String           @id @default(uuid()) @map("workspace_id") @db.Uuid
  developerId String           @map("developer_id") @db.Uuid
  developer   DeveloperAccount @relation(fields: [developerId], references: [id], onDelete: Cascade)
  name        String           @db.VarChar(100) // ex: "App Mobile Production", "Bot Support"
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  apiKeys ApiKey[]
  logs    DeveloperApiLog[]

  @@map("developer_workspaces")
}

/// Clés d'API Développeur
model ApiKey {
  id          String              @id @default(uuid()) @map("key_id") @db.Uuid
  developerId String              @map("developer_id") @db.Uuid
  developer   DeveloperAccount    @relation(fields: [developerId], references: [id], onDelete: Cascade)
  workspaceId String?             @map("workspace_id") @db.Uuid
  workspace   DeveloperWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  keyHash     String              @unique @map("key_hash") @db.VarChar(255)
  prefix      String              @db.VarChar(15) // ak_test_... ou ak_live_...
  name        String              @db.VarChar(50) // ex: "Application Mobile Prod"
  type        ApiKeyType          @default(SANDBOX)
  isActive    Boolean             @default(true) @map("is_active")
  lastUsedAt  DateTime?           @map("last_used_at") @db.Timestamptz
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@map("developer_api_keys")
}

/// Journal de Consommation & Télémétrie API Développeur
model DeveloperApiLog {
  id          String              @id @default(uuid()) @map("log_id") @db.Uuid
  developerId String              @map("developer_id") @db.Uuid
  developer   DeveloperAccount    @relation(fields: [developerId], references: [id], onDelete: Cascade)
  workspaceId String?             @map("workspace_id") @db.Uuid
  workspace   DeveloperWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  keyPrefix   String?             @map("key_prefix") @db.VarChar(15)
  endpoint    String              @db.VarChar(255)
  method      String              @default("POST") @db.VarChar(10)
  statusCode  Int                 @map("status_code")
  latencyMs   Int                 @map("latency_ms")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@index([developerId, createdAt(sort: Desc)])
  @@map("developer_api_logs")
}

/// Webhooks Développeur pour Callbacks de Statut et Messages Entrants (Standard WhatsApp)
model DeveloperWebhook {
  id          String           @id @default(uuid()) @map("webhook_id") @db.Uuid
  developerId String           @unique @map("developer_id") @db.Uuid
  developer   DeveloperAccount @relation(fields: [developerId], references: [id], onDelete: Cascade)
  url         String           @db.VarChar(500)
  verifyToken String?          @map("verify_token") @db.VarChar(100)
  secretKey   String?          @map("secret_key") @db.VarChar(100)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("developer_webhooks")
}

/// Codes OTP d'Authentification 2FA Développeur.
/// 🔴 TABLE MORTE — remplacée par [Verification], qui sale et hache le code
/// (celle-ci le stockait EN CLAIR dans `code`), compte les tentatives et
/// constate la livraison. Aucun code ne l'écrit plus.
/// ⚠️ NON SUPPRIMÉE : base partagée. Ne pas la réutiliser.
model DeveloperOtp {
  id              String           @id @default(uuid()) @map("otp_id") @db.Uuid
  developerId     String           @map("developer_id") @db.Uuid
  developer       DeveloperAccount @relation(fields: [developerId], references: [id], onDelete: Cascade)
  recipientNumber String           @map("recipient_number") @db.VarChar(30)
  code            String           @db.VarChar(10)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz
  isVerified      Boolean          @default(false) @map("is_verified")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([recipientNumber, code])
  @@map("developer_otps")
}

/// Registre des Médias API (Image, Audio, Documents - Standard WhatsApp Media API)
/// 🔴 TABLE MORTE depuis le 21/08/2026 — plus aucun code ne l'écrit ni ne la
/// lit. `POST /api/v1/media` téléverse désormais pour de vrai et crée un
/// [MediaFile] ordinaire, ce qui lui donne le contrôle d'accès de
/// `/api/media/:id`. Cette table n'enregistrait qu'une URL fournie par
/// l'appelant, avec une taille en dur et un type MIME jamais vérifié.
/// ⚠️ NON SUPPRIMÉE : base partagée avec un second système. Ne pas la
/// réutiliser — c'est [MediaFile] qui fait foi.
model DeveloperMedia {
  id          String           @id @default(uuid()) @map("media_id") @db.Uuid
  developerId String           @map("developer_id") @db.Uuid
  developer   DeveloperAccount @relation(fields: [developerId], references: [id], onDelete: Cascade)
  url         String           @db.VarChar(500)
  mimeType    String           @map("mime_type") @db.VarChar(100)
  size        Int
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@map("developer_medias")
}

/// Registre Financier Double-Entrée pour Développeurs (Ledger)
model DevLedger {
  id          String            @id @default(uuid()) @map("ledger_id") @db.Uuid
  developerId String            @map("developer_id") @db.Uuid
  developer   DeveloperAccount  @relation(fields: [developerId], references: [id], onDelete: Cascade)
  amount      BigInt            // Positif = recharge, Négatif = consommation
  type        TransactionType
  status      TransactionStatus @default(SETTLED)
  referenceId String?           @map("reference_id") @db.VarChar(100) // ID de message, ID d'appel ou ID Stripe
  description String?           @db.VarChar(255)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([developerId, createdAt])
  @@map("developer_ledgers")
}

// ===============================================================
// FILE D'ATTENTE TEMPS RÉEL (Table active : file)
// ===============================================================

/// File d'attente active des clients pour un centre, un service ou un agent.
/// Une ligne = un client actuellement en train d'attendre un agent libre.
/// Nettoyée dès que l'appel est pris en charge, abandonné ou expiré.
model QueueFile {
  idFile          Int      @id @default(autoincrement()) @map("idFile")
  idCompany       Int      @map("idCompany")
  center_alanyaID String   @map("center_alanyaID") @db.Uuid
  idService       Int?     @map("idService")
  idAgent         String?  @map("idAgent") @db.Uuid
  idCustomer      String   @map("idCustomer") @db.Uuid
  
  /// Position / Rang du client dans la file (1, 2, 3...)
  rang            Int      @default(1)
  /// Niveau de priorité (0 = normal, 1 = VIP, 2 = urgent)
  priorite        Int      @default(0) @db.SmallInt
  
  /// Date et heure d'entrée dans la file
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations Prisma
  company    Company  @relation(fields: [idCompany], references: [idCompany], onDelete: Cascade)
  centerUser User     @relation("QueueCenterUser", fields: [center_alanyaID], references: [id], onDelete: Cascade)
  service    Service? @relation(fields: [idService], references: [idService], onDelete: SetNull)
  agent      User?    @relation("QueueAgentUser", fields: [idAgent], references: [id], onDelete: SetNull)
  customer   User     @relation("QueueCustomerUser", fields: [idCustomer], references: [id], onDelete: Cascade)

  @@unique([center_alanyaID, idCustomer], map: "queue_file_center_customer_key")
  @@index([center_alanyaID, rang(sort: Asc)], map: "queue_file_center_rang_idx")
  @@index([idService, rang(sort: Asc)], map: "queue_file_service_rang_idx")
  @@index([idAgent], map: "queue_file_idAgent_idx")
  @@map("file")
}

// ===============================================================
// HISTORIQUE DE LA FILE D'ATTENTE (Table d'archivage : file_historique)
// ===============================================================

/// Statut final du passage en file d'attente.
enum QueueStatus {
  MIS_EN_RELATION // Le client a pu contacter l'agent (succès)
  ABANDON         // Le client a raccroché pendant l'attente
  TIMEOUT         // Attente maximale atteinte sans réponse
  REJETE          // File pleine ou rejeté
  RECONTACTER     // Rappelé par un agent APRÈS un abandon, et il a décroché
}

/// Historique complet de la file d'attente pour chaque appel vers un centre.
/// Permet de mesurer les statistiques par service, par agent, les abandons,
/// les durées d'attente et la note globale sur 5 attribuée par le client.
model QueueFileHistorique {
  idHist          BigInt      @id @default(autoincrement()) @map("idHist")
  idCompany       Int         @map("idCompany")
  center_alanyaID String      @map("center_alanyaID") @db.Uuid
  idService       Int?        @map("idService")
  idAgent         String?     @map("idAgent") @db.Uuid
  idCustomer      String      @map("idCustomer") @db.Uuid

  /// Statut de l'attente : MIS_EN_RELATION, ABANDON, TIMEOUT, REJETE
  statut          QueueStatus @default(MIS_EN_RELATION)

  /// Heure d'entrée dans la file
  joinedAt        DateTime    @default(now()) @map("joined_at") @db.Timestamptz
  /// Heure de sortie de la file (prise en charge ou abandon)
  leftAt          DateTime?   @map("left_at") @db.Timestamptz
  /// Temps passé à attendre en secondes
  attenteDureeSec Int         @default(0) @map("attente_duree_sec")
  /// Durée de la communication effective avec l'agent en secondes (0 si abandon)
  appelDureeSec   Int         @default(0) @map("appel_duree_sec")

  /// Note de satisfaction optionnelle donnée par le client à la fin (1 à 5 étoiles)
  note            Int?        @db.SmallInt
  /// Avis/Commentaire optionnel laissé par le client
  avisCommentaire String?     @map("avis_commentaire") @db.Text

  // Relations Prisma
  company    Company  @relation(fields: [idCompany], references: [idCompany], onDelete: Cascade)
  centerUser User     @relation("QueueHistCenterUser", fields: [center_alanyaID], references: [id], onDelete: Cascade)
  service    Service? @relation(fields: [idService], references: [idService], onDelete: SetNull)
  agent      User?    @relation("QueueHistAgentUser", fields: [idAgent], references: [id], onDelete: SetNull)
  customer   User     @relation("QueueHistCustomerUser", fields: [idCustomer], references: [id], onDelete: Cascade)

  @@index([idCompany, joinedAt(sort: Desc)], map: "queue_hist_company_joined_idx")
  @@index([center_alanyaID, joinedAt(sort: Desc)], map: "queue_hist_center_joined_idx")
  @@index([idService, joinedAt(sort: Desc)], map: "queue_hist_service_joined_idx")
  @@index([idAgent, joinedAt(sort: Desc)], map: "queue_hist_agent_joined_idx")
  @@index([statut], map: "queue_hist_statut_idx")
  @@map("file_historique")
}
