model Center {
  idCenter        Int      @id @default(autoincrement()) @map("idcenter")
  libelle         String   @db.VarChar(45)
  center_alanyaID String?  @map("center_alanyaid") @db.Uuid
  users_alanyaID  String?  @map("users_alanyaid") @db.Uuid
  idCompany       Int?     @map("idcompany")
  menuNro         Int?     @map("menunro")
  in_call         Boolean? @default(false)
  /// Nom du service tel qu'il doit être MONTRÉ à l'appelant, ajouté en base par
  /// la plateforme du collègue et déclaré ici le 12/08/2026. `libelle` reste le
  /// nom interne de la ligne et sert de repli quand celle-ci est vide.
  nomService      String?  @map("nom_service") @db.VarChar(45)
  /// Lien vers le catalogue formel `service`, ajouté le 15/08/2026 : `center`
  /// (routage par touche) et `service` (catalogue par entreprise) n'avaient
  /// jamais été reliés. Sert à remplir `QueueFile`/`QueueFileHistorique.idService`
  /// avec le VRAI service choisi, plutôt qu'une correspondance devinée par nom.
  idService       Int?     @map("idservice")
  /// Cet agent peut-il enregistrer ses conversations avec un client ?
  ///
  /// ⚠️ COLONNE À NOUS DANS UNE TABLE DU RÉFÉRENTIEL ÉQUIPE — choix explicite
  /// du user (19/08/2026), contre la règle habituelle du projet. C'est un écart
  /// de plus à défendre à la prochaine harmonisation, et la plateforme de la
  /// collègue l'effacerait si elle recréait `center`.
  ///
  /// Aucune table de liaison n'a été créée, et il n'en fallait pas : une ligne
  /// de `center` EST déjà le triplet (centre, touche, agent). Le réglage est
  /// donc individuel par agent, et modifier un centre n'atteint aucun autre.
  enregistrement  Boolean  @default(false)

  centerUser   User?    @relation("centerUser", fields: [center_alanyaID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedUser User?    @relation("assignedUser", fields: [users_alanyaID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  company      Company? @relation(fields: [idCompany], references: [idCompany], onDelete: Cascade, onUpdate: Cascade)
  service      Service? @relation(fields: [idService], references: [idService], onDelete: SetNull, onUpdate: Cascade)

  @@index([center_alanyaID], map: "center_center_alanyaid_idx")
  @@index([users_alanyaID], map: "center_users_alanyaid_idx")
  @@index([idCompany], map: "center_idcompany_idx")
  @@index([idService], map: "center_idservice_idx")
  @@map("center")
}

/// Invite vocale d'un centre d'appels : « Bienvenue chez… tapez 1 pour… ».
///
/// ⚠️ CETTE TABLE N'EST PAS DE NOUS ET EXISTAIT DÉJÀ EN PRODUCTION, posée par la
/// plateforme du collègue — elle contenait une ligne avant qu'une seule de ces
/// lignes de schéma ne soit écrite. Elle est déclarée ici, à l'identique, pour
/// la même raison que `geo` l'a été : tant qu'un modèle manque, **Prisma ne peut
/// pas lire la table**, et une base neuve repartirait sans elle. Ne rien y
/// ajouter sans l'équipe : c'est leur objet, pas le nôtre.
///
/// Elle remplace la convention de nommage `public/ivr/<Alanya ID>.mp3`, qui
/// liait le message au numéro et obligeait à déposer un fichier sur le serveur
/// pour changer une invite.
///
/// `url_vocal` est un CHEMIN, pas forcément une URL : la ligne de production
/// vaut `/uploads/vocaux/vocal-….wav`, servi par la plateforme du collègue et
/// non par nous. La résolution est dans `src/lib/ivr.mjs`.
///
/// L'unicité porte sur **(entreprise, centre)** et non sur le centre seul : le
/// même numéro peut donc théoriquement porter une invite par entreprise.
model Vocal {
  idVocal         Int    @id @default(autoincrement()) @map("idVocal")
  idCompany       Int    @map("idCompany")
  center_alanyaID String @map("center_alanyaID") @db.Uuid
  urlVocal        String @map("url_vocal") @db.VarChar(255)

  company    Company @relation(fields: [idCompany], references: [idCompany], onDelete: Cascade, onUpdate: Cascade)
  centerUser User    @relation("vocalCentre", fields: [center_alanyaID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idCompany, center_alanyaID], map: "vocal_company_center_key")
  @@index([idCompany], map: "vocal_idCompany_idx")
  @@map("vocal")
}

/// Musique d'attente d'un centre, jouée pendant qu'on cherche un agent.
///
/// ⚠️ JUMELLE EXACTE DE [Vocal] — mêmes colonnes, même unicité, même plateforme
/// d'origine. Créée par la collègue le 12/08/2026, elle non plus n'est pas de
/// nous : ne rien y ajouter sans l'équipe.
///
/// Elle remplace la convention `public/ivr/attente-*.mp3`, et change la règle au
/// passage : le dossier tirait **au sort parmi plusieurs titres**, la table donne
/// **un titre par centre**. Le dossier reste comme repli, pour les centres qui
/// n'ont pas de ligne.
model CenterMusic {
  idMusic         Int    @id @default(autoincrement()) @map("idMusic")
  idCompany       Int    @map("idCompany")
  center_alanyaID String @map("center_alanyaID") @db.Uuid
  urlMusic        String @map("url_music") @db.VarChar(255)

  company    Company @relation(fields: [idCompany], references: [idCompany], onDelete: Cascade, onUpdate: Cascade)
  centerUser User    @relation("musiqueCentre", fields: [center_alanyaID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idCompany, center_alanyaID], map: "center_music_company_center_key")
  @@index([idCompany], map: "center_music_idCompany_idx")
  @@map("center_music")
}

/// Musiques d'attente d'un centre d'appels quand tous les agents sont occupés.
///
/// Créée par la collègue pour gérer les attentes des clients lorsqu'ils contactent
/// un centre dont tous les agents sont occupés. Contient une série de musiques
/// classées par ordre d'écoute.
model VocalAttente {
  idVocalAttente  Int     @id @default(autoincrement()) @map("idVocalAttente")
  idCompany       Int     @map("idCompany")
  center_alanyaID String  @map("center_alanyaID") @db.Uuid
  titre           String? @db.VarChar(150)
  urlVocal        String  @map("url_vocal") @db.VarChar(255)
  ordre           Int     @default(1)

  company    Company @relation(fields: [idCompany], references: [idCompany], onDelete: Cascade, onUpdate: Cascade)
  centerUser User    @relation("vocalAttenteCentre", fields: [center_alanyaID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([idCompany], map: "vocal_attente_idCompany_idx")
  @@index([center_alanyaID], map: "vocal_attente_center_alanyaID_idx")
  @@map("vocal_attente")
}

/// Le menu d'un CENTRE VOCAL : un audio par touche.
///
/// ⚠️ TABLE DE LA PLATEFORME DU COLLÈGUE, présente en production bien avant
/// d'être déclarée ici (18/08/2026) — comme l'ont été `geo`, `vocal`,
/// `center_music` et `company.url_serveur`. Ne rien y ajouter sans l'équipe.
///
/// C'est l'équivalent de [Center] pour un centre vocal, et la différence tient
/// en un mot : `center` fait pointer une touche vers un AGENT à faire sonner,
/// `center_audio` la fait pointer vers un SON à jouer. Un centre vocal n'a donc
/// aucune ligne `center`, et réciproquement.
///
/// ⚠️ `url_audio` est un CHEMIN, pas une URL — même piège que `Vocal.urlVocal` :
/// les lignes de production valent `/uploads/audios_menu/…`, relatifs au serveur
/// de la plateforme. Toujours passer par `resoudreUrlPlateforme` de `ivr.mjs`,
/// jamais lire la colonne telle quelle.
///
/// L'unicité `(center_alanyaID, menunro)` est posée en base comme INDEX unique
/// et non comme contrainte : une touche porte donc au plus un son, il n'y a
/// aucun départage à écrire (contrairement à [Vocal], dont l'unicité inclut
/// l'entreprise et qui peut avoir plusieurs lignes pour un même numéro).
model CenterAudio {
  idCenterAudio   Int      @id @default(autoincrement()) @map("idcenteraudio")
  idCompany       Int      @map("idCompany")
  center_alanyaID String   @map("center_alanyaID") @db.Uuid
  /// La touche, bornée 0–9 en base par un CHECK — c'est un pavé téléphonique.
  menuNro         Int      @map("menunro") @db.SmallInt
  /// Le nom montré sur la touche. ⚠️ NULLABLE, et vide sur 3 des 4 lignes de
  /// production : le repli est le nom du centre vocal, décidé par le user le
  /// 18/08/2026 (même règle que `center.libelle` pour un centre d'appels).
  titre           String?  @db.VarChar(150)
  urlAudio        String   @map("url_audio") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company    Company @relation(fields: [idCompany], references: [idCompany], onDelete: Cascade, onUpdate: Cascade)
  centerUser User    @relation("audioCentreVocal", fields: [center_alanyaID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([center_alanyaID, menuNro], map: "center_audio_center_menunro_key")
  @@index([idCompany], map: "center_audio_idCompany_idx")
  @@map("center_audio")
}

/// Plainte laissée oralement par un appelant sur la touche 0 d'un centre vocal.
///
/// SQL : `prisma/manual/2026-08_plainte_vocale.sql`, éprouvé sur base jetable.
///
/// Le FICHIER n'est jamais en base : `media` pointe `media_files`, qui porte
/// déjà stockage, type MIME et durée.
model VoiceComplaint {
  idComplaint     String   @id @default(uuid()) @map("idComplaint") @db.Uuid
  idCompany       Int      @map("idCompany")
  center_alanyaID String   @map("center_alanyaID") @db.Uuid
  /// ⚠️ NULLABLE À DESSEIN : un compte supprimé ne doit pas emporter la
  /// plainte. Elle appartient à l'entreprise qui doit la traiter, pas à son
  /// auteur — prouvé sur base jetable, la ligne survit à un `DELETE` du compte.
  userId          String?  @map("user_id") @db.Uuid
  mediaId         String   @map("media_id") @db.Uuid
  /// Redondante avec `media_files.durationMs`, et c'est voulu : c'est la seule
  /// mesure qu'un écran de tri lit sans joindre, et elle doit survivre à une
  /// purge des médias.
  dureeMs         Int      @default(0) @map("duree_ms")
  /// 0 reçue, 1 en cours, 2 traitée, 3 rejetée. Un entier borné par un CHECK
  /// et non une enum : tout le référentiel équipe code ses statuts ainsi, et
  /// une enum PostgreSQL se migre bien plus mal.
  statut          Int      @default(0) @db.SmallInt
  /// 🔴 CE QUI REND L'ENVOI IDEMPOTENT, par CONTRAINTE et non par du code. Le
  /// client pose une clé par enregistrement ; réseau qui hésite, double appui
  /// ou réessai ne peuvent pas produire deux plaintes. Le contournement a été
  /// TENTÉ sur base jetable : rejeté par l'index unique.
  cleEnvoi        String   @map("cle_envoi") @db.VarChar(64)
  /// URL ABSOLUE de l'audio, lisible SANS jeton — la plateforme de la collègue
  /// lit cette table directement et n'a pas notre mécanisme d'authentification.
  ///
  /// ⚠️ **CE N'EST PAS UN CONTRÔLE D'ACCÈS** : quiconque la connaît écoute la
  /// plainte. Elle est indevinable (elle porte l'UUID de la plainte), ce qui est
  /// le compromis habituel pour du média, mais reste de l'obscurité.
  urlAudio        String?  @map("url_audio") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company    Company   @relation(fields: [idCompany], references: [idCompany], onDelete: Cascade, onUpdate: Cascade)
  centerUser User      @relation("plainteCentreVocal", fields: [center_alanyaID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  auteur     User?     @relation("plainteAuteur", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  media      MediaFile @relation(fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([cleEnvoi], map: "voice_complaint_cle_envoi_key")
  @@index([center_alanyaID, createdAt(sort: Desc)], map: "voice_complaint_centre_date_idx")
  @@index([idCompany], map: "voice_complaint_company_idx")
  @@map("voice_complaint")
}

/// Enregistrement d'une conversation agent ↔ client d'un centre d'appels.
///
/// SQL : `prisma/manual/2026-08_enregistrement_appel.sql`, éprouvé sur base
/// jetable. L'AUTORISATION, elle, vit dans `Center.enregistrement`.
///
/// 🔴 DEUX PISTES, PUIS UNE TROISIÈME. Le greffon `flutter_webrtc` ne sait
/// enregistrer QU'UN côté à la fois — vérifié dans son code Android, où
/// `startRecordingToFile` choisit `inputSamplesInterceptor` OU
/// `outputSamplesInterceptor`, jamais les deux. Le téléphone envoie donc le
/// micro et le distant séparément, et le serveur les mélange. C'est ce qui
/// évite de maintenir un fork d'une dépendance critique.
model CallRecording {
  idRecording     String   @id @default(uuid()) @map("idRecording") @db.Uuid
  idCompany       Int      @map("idCompany")
  callId          String?  @map("call_id") @db.Uuid
  agentId         String?  @map("agent_alanyaID") @db.Uuid
  clientId        String?  @map("client_alanyaID") @db.Uuid

  /// ⚠️ CONSERVÉES même après le mélange, et ce n'est pas du gaspillage : c'est
  /// la seule façon de le REFAIRE si ffmpeg change ou si le résultat est
  /// mauvais. Les effacer ferait de la première tentative la dernière.
  mediaAgentId    String   @map("media_agent_id") @db.Uuid
  mediaClientId   String   @map("media_client_id") @db.Uuid

  /// Nul tant que le mélange n'a pas eu lieu — état NORMAL, pas une panne :
  /// ffmpeg peut manquer sur le serveur, l'enregistrement reste alors
  /// exploitable en deux pistes.
  mediaMixId      String?  @map("media_mix_id") @db.Uuid

  dureeMs         Int      @default(0) @map("duree_ms")
  /// 0 à mélanger · 1 en cours · 2 mélangé · 3 mélange impossible.
  statut          Int      @default(0) @db.SmallInt
  cleEnvoi        String   @map("cle_envoi") @db.VarChar(64)
  /// URL ABSOLUE de l'enregistrement MÉLANGÉ, lisible SANS jeton — la plateforme
  /// de la collègue lit cette table directement et n'a pas notre mécanisme
  /// d'authentification. Décision du user du 21/08/2026, en réponse à la
  /// question laissée ouverte dans la note d'équipe du 20/08.
  ///
  /// 🔴 POSÉE PAR LA MÊME REQUÊTE QUE `statut = 2` : une adresse présente ici
  /// est donc une adresse qui répond. Nulle tant que le mélange n'a pas abouti.
  ///
  /// ⚠️ **CE N'EST PAS UN CONTRÔLE D'ACCÈS**, et l'enjeu dépasse celui d'une
  /// plainte : c'est une CONVERSATION ENTIÈRE, à deux voix, dont le
  /// correspondant n'a jamais été averti. Quiconque connaît l'URL l'écoute ;
  /// elle est seulement indevinable (elle porte l'UUID de l'enregistrement).
  urlAudio        String?  @map("url_audio") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company    @relation(fields: [idCompany], references: [idCompany], onDelete: Cascade, onUpdate: Cascade)
  call        Call?      @relation(fields: [callId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  agent       User?      @relation("enregistrementAgent", fields: [agentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  client      User?      @relation("enregistrementClient", fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  mediaAgent  MediaFile  @relation("enregistrementPisteAgent", fields: [mediaAgentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaClient MediaFile  @relation("enregistrementPisteClient", fields: [mediaClientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaMix    MediaFile? @relation("enregistrementMelange", fields: [mediaMixId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([cleEnvoi], map: "call_recording_cle_envoi_key")
  @@index([agentId, createdAt(sort: Desc)], map: "call_recording_agent_date_idx")
  @@index([idCompany], map: "call_recording_company_idx")
  @@map("call_recording")
}

model AccesAdmin {
  idaccesAdmin Int       @id @default(autoincrement()) @map("idaccesadmin")
  idAdmin      Int?      @map("idadmin")
  idRoot       Int?      @map("idroot")
  acces_at     DateTime? @default(now()) @db.Timestamp(6)
  ipAdress     String    @map("ipadress") @db.VarChar(30)

  admin     Admin?     @relation(fields: [idAdmin], references: [idAdmin], onDelete: Cascade, onUpdate: Cascade)
  adminRoot AdminRoot? @relation(fields: [idRoot], references: [idRoot], onDelete: Cascade, onUpdate: Cascade)

  @@index([idAdmin], map: "accesadmin_idadmin_idx")
  @@index([idRoot], map: "accesadmin_idroot_idx")
