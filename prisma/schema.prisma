// Schéma de données Alanya — PostgreSQL + Prisma
// Dérivé du cahier des charges (Groupe Alanya II), enrichi : numéro public 6 chiffres,
// statuts éphémères (stories) et IA conversationnelle (Gemini).
//
// Conventions (cf. cahier des charges) :
//  - Clés primaires en UUID
//  - Dates en TIMESTAMPTZ (DateTime @db.Timestamptz)
//  - Mots de passe hachés (BCrypt) avant insertion
//  - Index sur les colonnes fréquemment filtrées

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH & COMPTE
// ---------------------------------------------------------------------------

model User {
  // Colonnes physiques alignées sur le référentiel équipe (alanya.sql).
  // Les noms de champ Prisma restent inchangés → code applicatif et contrat API intacts ;
  // seuls les noms de colonnes Postgres changent via @map (UUID conservés).
  id            String   @id @default(uuid()) @map("alanyaID") @db.Uuid
  email         String   @unique @db.VarChar(100)
  passwordHash  String?  @map("password") @db.VarChar(255)
  /// VarChar(20) depuis le 30/07/2026, pour suivre le référentiel équipe.
  /// L'unicité est CONSERVÉE, contrairement à leur fichier : sans elle, deux
  /// comptes pourraient porter le même Alanya ID.
  /// La génération reste à 8 chiffres (src/lib/publicNumber.ts) et la
  /// validation n'accepte que 6 ou 8 (src/lib/validation.ts).
  publicNumber  String   @unique @map("alanyaPhone") @db.VarChar(20)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz

  // --- F1 : Inscription avec pays ---
  nom    String? @db.VarChar(100)
  idPays Int?    @map("idPays") @db.SmallInt
  pays   Pays?   @relation(fields: [idPays], references: [idPays])

  // --- F3 : Type de compte & statut actif ---
  typeCompte Int     @default(0) @map("type_compte") @db.SmallInt
  actif      Int     @default(1) @db.SmallInt
  /// ⚠️ `@unique` OBLIGATOIRE : la contrainte existe en base depuis toujours.
  /// Sans cette déclaration, Prisma croit devoir la supprimer — c'est
  /// exactement ce qui a fait échouer un `db push` lancé sur la production le
  /// 06/08/2026, après qu'il eut deja supprime trois index. PostgreSQL a
  /// refuse (« cannot drop index users_mobile_key because constraint ...
  /// requires it »), ce qui a stoppe la casse. Ne pas retirer.
  mobile     String? @unique @db.VarChar(20)

  // --- F4 : Profil fusionné (anciennement dans Profile) ---
  pseudo    String?   @map("pseudo") @db.VarChar(50)
  /// `Text` et non `VarChar(2048)` : la plus longue valeur en base atteignait
  /// déjà 1955 caractères le 30/07/2026. La troncature n'était plus loin.
  avatarUrl String?   @map("avatar_url") @db.Text
  statusMsg String?   @map("status_msg") @db.VarChar(255)
  lastSeen  DateTime? @map("last_seen") @db.Timestamptz

  // --- F5 : Présence en ligne ---
  isOnline Int @default(0) @map("is_online") @db.SmallInt

  // --- Confidentialité (Phase 3.1) ---
  // readReceipts : 1 = envoie/reçoit les confirmations de lecture, 0 = off.
  // lastSeenVisibility : 0 = personne, 1 = mes contacts, 2 = tout le monde.
  readReceipts       Int @default(1) @map("read_receipts") @db.SmallInt
  lastSeenVisibility Int @default(2) @map("last_seen_visibility") @db.SmallInt

  // --- F6 : Exclusion de compte ---
  exclus        Int       @default(0) @db.SmallInt
  excludeAt     DateTime? @map("exclude_at") @db.Timestamptz
  excludeReason String?   @map("exclude_reason") @db.VarChar(255)

  // --- F7 : Biométrie / état d'appel / device (colonnes du référentiel) ---
  inCall            Int       @default(0) @map("in_call") @db.SmallInt
  biometric         Int       @default(0) @db.SmallInt
  /// Nombre de sessions simultanées autorisées : **1 mobile + (ce nombre − 1)
  /// navigateurs**. Réglé par compte depuis la plateforme d'administration.
  ///
  /// ⚠️ LE DÉFAUT EST 2 — un mobile et un navigateur — et il DOIT rester
  /// identique ici et en base. Prisma envoie sa propre valeur par défaut dans
  /// l'ordre d'insertion : laissé à 1, il créerait des comptes sans accès web
  /// alors que la base, elle, dirait 2. Migration :
  /// `prisma/manual/2026-08_sessions_par_compte.sql`.
  appareilTotal     Int       @default(2) @map("appareil_total") @db.SmallInt
  fcmToken          String?   @map("fcm_token") @db.VarChar(255)
  deviceId          String?   @map("device_ID") @db.VarChar(255)
  resetOtp          String?   @map("reset_otp") @db.VarChar(6)
  resetOtpExpiresAt DateTime? @map("reset_otp_expires_at") @db.Timestamptz

  /// Suppression logique, ajoutée par James. ⚠️ `users` porte désormais TROIS
  /// notions d'inactivité : `actif` (l'utilisateur), `exclus` (décision
  /// d'administration) et `isDelete` (effacement). Rien ne dit laquelle fait
  /// foi — à clarifier avec l'équipe avant que du code ne s'appuie dessus.
  isDelete Boolean @default(false) @map("isDelete")

  refreshTokens    RefreshToken[]
  contacts         Contact[]           @relation("UserContacts")
  contactOf        Contact[]           @relation("ContactOf")
  contactLists     ContactList[]       @relation("UserContactLists")
  /// Listes d'AUTRES comptes ou ce compte figure comme membre. Relation inverse
  /// seule : elle n'ajoute aucune colonne a `users`.
  contactListsIn   ContactListMember[] @relation("ContactListMemberOf")
  /// Catalogue des sonneries que ce compte a importees. Le FICHIER suivait deja
  /// le compte (il est dans `media_files`) ; la liste de ce qui a ete importe,
  /// non — elle vivait en localStorage. Voir [UserRingtone].
  ringtones        UserRingtone[]
  participations   Participant[]
  sentMessages     Message[]           @relation("MessageSender")
  ownedMedia       MediaFile[]
  statuses         Status[]
  statusViews      StatusView[]
  callsInitiated   Call[]            @relation("CallInitiator")
  /// Appels où ce compte sert d'identité de rappel (voir `Call.callerMaskId`).
  callsAsMask      Call[]            @relation("CallCallerMask")
  callParticipants CallParticipant[]
  aiThreads        AiThread[]
  pushDevices      PushDevice[]
  messageHides     MessageHide[]
  messageReactions MessageReaction[]
  messageStars     MessageStar[]

  // --- Nouvelles relations (schéma PDF) ---
  organizedMeetings     Meeting[]            @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[] @relation("MeetingParticipantUser")
  demandesFormulees     MeetingInviteRequest[] @relation("MeetingRequestAuthor")
  demandesRecues        MeetingInviteRequest[] @relation("MeetingRequestInvitee")
  blockedUsers          Blocked[]            @relation("BlockOwner")
  blockedByUsers        Blocked[]            @relation("BlockedUser")
  conversationLocks     ConversationLock[]

  // --- Espace Développeur ---
  developerAccount DeveloperAccount?

  // --- Relations vers les nouvelles tables du référentiel ---
  accessLogs      UserAccess[]
  /// Relevés de position — alimentés par le MOBILE uniquement. Voir [Geo].
  positions       Geo[]
  geoConsentement GeoConsentement?
  callsMade       CallHistory[]         @relation("CallCaller")
  callsReceived   CallHistory[]         @relation("CallReceiver")
  reservedPhones  ReservedAlanyaPhone[]
  appareils       Appareil[]
  customerChats   CustomerChat[]
  rapportsAsAgent RapportChat[]
  bordereauxAgent BordereauAgent[]
  /// Transferts que CET agent a effectués — distinct des services émetteur et
  /// destinataire, qui disent d'où vient le rapport et où il va, pas qui l'a
  /// déplacé.
  transfertsAgent Transferer[]          @relation("TransfertAgent")

  // --- Organisation / centre d'appels (référentiel équipe) ---
  // Seule `idCompany` ajoute une colonne à `users` ; les quatre suivantes sont
  // des relations inverses, sans existence en base.
  idCompany       Int?             @map("idcompany")
  company         Company?         @relation(fields: [idCompany], references: [idCompany], onDelete: SetNull)
  Fonctions       Fonction[]
  GestionCompany  GestionCompany[]
  centerUsers     Center[]         @relation("centerUser")
  assignedCenters Center[]         @relation("assignedUser")
  vocaux          Vocal[]          @relation("vocalCentre")
  musiques        CenterMusic[]    @relation("musiqueCentre")
  vocauxAttente   VocalAttente[]   @relation("vocalAttenteCentre")
  audiosMenu      CenterAudio[]    @relation("audioCentreVocal")
  /// Les plaintes vocales reçues par ce centre vocal, et celles que ce compte a
  /// laissées ailleurs. Deux relations distinctes vers la même table : un même
  /// compte peut être l'un ou l'autre, jamais confondus.
  plaintesRecues  VoiceComplaint[] @relation("plainteCentreVocal")
  plaintesLaissees VoiceComplaint[] @relation("plainteAuteur")
  /// Enregistrements de conversations où ce compte est l'agent, et ceux où il
  /// est le correspondant. Deux relations distinctes, jamais confondues.
  enregistrementsAgent  CallRecording[] @relation("enregistrementAgent")
  enregistrementsClient CallRecording[] @relation("enregistrementClient")

  // --- Relations vers la file d'attente ---
  queueCenterFiles   QueueFile[]           @relation("QueueCenterUser")
  queueAgentFiles    QueueFile[]           @relation("QueueAgentUser")
  queueCustomerFiles QueueFile[]           @relation("QueueCustomerUser")
  queueCenterHists   QueueFileHistorique[] @relation("QueueHistCenterUser")
  queueAgentHists    QueueFileHistorique[] @relation("QueueHistAgentUser")
  queueCustomerHists QueueFileHistorique[] @relation("QueueHistCustomerUser")

  @@index([publicNumber])
  @@index([idCompany])
  /// Existait en base sans etre declare ici : Prisma voulait donc le
  /// supprimer, et l'a fait le 06/08/2026 sur la production.
  @@index([idPays])
  @@map("users")
}

/// Registre des appareils d'un compte — une ligne par appareil, mise à jour au
/// fil de l'eau. Alimente l'écran « Appareils connectés ».
///
/// À distinguer de [UserAccess], qui est un journal (une ligne par connexion,
/// jamais modifiée), et de [PushDevice], qui ne porte qu'un jeton FCM sans état
/// présentable à l'utilisateur.
///
/// Conventions : `typeDevice` 0=web 1=Android 2=iOS 3=bureau ;
/// `isOnline` 0/1 ; `destroy` 1 = déconnecté à distance (effacement logique,
/// la ligne est conservée pour l'historique).
model Appareil {
  appareilId   Int       @id @default(autoincrement()) @map("appareilID")
  /// Identifiant stable du navigateur, généré côté client et gardé en
  /// localStorage. Nul pour les appareils mobiles.
  cookiesWebId String?   @map("cookies_WebID") @db.VarChar(255)
  libelle      String    @default("Appareil") @db.VarChar(45)
  isOnline     Int       @default(0) @map("is_online") @db.SmallInt
  createAt     DateTime  @default(now()) @map("create_at") @db.Timestamptz
  typeDevice   Int       @default(0) @db.SmallInt
  lastLogin    DateTime? @db.Timestamptz
  system       String?   @db.VarChar(45)
  /// Nom de l'agent associé à l'appareil. Nullable : les lignes existantes n'en
  /// ont pas, et le remplir de force par un défaut inventé donnerait une
  /// information fausse plutôt qu'absente.
  agent        String?   @db.VarChar(50)
  /// Agent propriétaire de l'appareil — un utilisateur. La colonne s'appelait
  /// `alanyaID` ; le renommage en `idAgent` dit ce qu'elle désigne vraiment
  /// depuis que ce registre sert le centre d'appels.
  ///
  /// ⚠️ Cette colonne n'est PAS unique : un agent a plusieurs appareils. Aucune
  /// clé étrangère ne peut donc la cibler — pointer vers `users.alanyaID`.
  /// Champ renommé « alanyaId » pour suivre le référentiel équipe ; la
  /// COLONNE reste « idAgent », d'où le @map. Rien ne bouge en base.
  alanyaId     String    @map("idAgent") @db.Uuid
  user         User      @relation(fields: [alanyaId], references: [id], onDelete: Cascade)
  destroy      Int       @default(0) @db.SmallInt

  customerChats CustomerChat[]

  /// Unicité sur le COUPLE (navigateur, agent) : deux comptes utilisés tour à
  /// tour dans le même navigateur gardent chacun leur entrée.
  @@unique([cookiesWebId, alanyaId], map: "Appareil_cookies_idAgent_key")
  /// Pseudo unique AU SEIN d'un compte : deux postes du même numéro appelés
  /// « Accueil » rendraient inutile la réponse à « qui a envoyé ce message ».
  /// Deux numéros différents peuvent en revanche avoir chacun leur « Accueil ».
  ///
  /// PostgreSQL traite les NULL comme distincts : les appareils sans pseudo
  /// restent libres, aussi nombreux soient-ils.
  @@unique([alanyaId, agent], map: "Appareil_idAgent_agent_key")
  /// Couvre aussi les recherches sur le seul `idAgent` (préfixe gauche) : pas
  /// besoin d'un second index sur cette colonne.
  @@index([alanyaId, destroy, lastLogin(sort: Desc)], map: "Appareil_idAgent_destroy_idx")
  @@map("Appareil")
}

/// Sessions de discussion client — une ligne par session, ouverte à
/// `startTime` et refermée à `endTime`.
///
/// `endTime` nul signifie « session en cours » : c'est ce qui permet de
/// retrouver les sessions ouvertes sans colonne d'état supplémentaire.
///
/// `isFree` suit la convention du projet pour les booléens (0/1 en SMALLINT,
/// comme `isOnline` ou `destroy`) plutôt qu'un vrai BOOLEAN, pour rester
/// homogène avec le référentiel.
model CustomerChat {
  id         Int       @id @default(autoincrement()) @map("ID")
  appareilId Int       @map("appareilID")
  appareil   Appareil  @relation(fields: [appareilId], references: [appareilId], onDelete: Cascade)
  /// Le client de la session. La colonne s'appelait `AlanyaID` ; `customerID`
  /// la distingue de l'agent, qui est à l'autre bout de la discussion.
  alanyaId   String    @map("AlanyaID") @db.Uuid
  user       User      @relation(fields: [alanyaId], references: [id], onDelete: Cascade)
  startTime  DateTime  @default(now()) @map("start_time") @db.Timestamptz
  endTime    DateTime? @map("end_time") @db.Timestamptz
  isFree     Int       @default(1) @db.SmallInt

  /// `isResolved` a été DÉPLACÉ vers `RapportChat.is_resolve` : la résolution
  /// est un état du ticket, pas de la session. Une discussion peut se terminer
  /// sans que la réclamation soit réglée.

  rapportsChat RapportChat[]

  /// Les sessions d'un client, la plus récente d'abord. Le préfixe gauche
  /// couvre aussi les recherches sur le seul `customerId`.
  @@index([alanyaId, startTime(sort: Desc)], map: "customerChat_AlanyaID_start_idx")
  /// PostgreSQL n'indexe pas automatiquement les clés étrangères : sans cet
  /// index, toute suppression d'appareil imposerait un parcours complet.
  @@index([appareilId], map: "customerChat_appareilID_idx")
  @@map("customerChat")
}

/// Compte rendu d'une session de discussion client.
///
/// `idAgent` pointe vers `users.alanyaID` et NON vers `Appareil.idAgent` :
/// cette dernière n'est pas unique (un agent a plusieurs appareils), donc
/// aucune clé étrangère ne peut la cibler. La valeur est la même, prise à sa
/// source — et le rapport reste rattaché à l'agent même s'il change de poste.
/// C'est aussi un **ticket** : il circule entre services et agents jusqu'à
/// résolution, et chaque étape laisse une trace (transferts, bordereaux,
/// commentaires) — modèle tidesk.
///
/// Clé primaire nommée `idRap` d'après ce modèle. Les tables filles gardent
/// `idRapport` comme nom de colonne étrangère, également d'après le modèle.
model RapportChat {
  idRap        Int           @id @default(autoincrement())
  idCustomer   Int?
  /// SetNull sur le client comme sur l'agent : retirer l'un ou l'autre ne doit
  /// plus effacer le rapport, qui est justement la trace de leur échange.
  customerChat CustomerChat? @relation(fields: [idCustomer], references: [id], onDelete: SetNull)
  /// Reste en UUID, là où le modèle tidesk le type en INT : nos agents SONT
  /// des utilisateurs, il n'existe pas de table d'agents séparée à cibler.
  idAgent      String?       @db.Uuid
  agent        User?         @relation(fields: [idAgent], references: [id], onDelete: SetNull)
  resume       String?       @db.Text
  /// Obligatoire : un rapport sans objet n'est pas exploitable.
  subject      String        @db.VarChar(150)
  /// Numéro de rappel du client, saisi par l'agent. Ajouté directement en base
  /// par l'équipe ; ce champ ne fait que refléter la colonne existante —
  /// `character varying(20)`, nullable, relevée sur la prod le 31/07/2026.
  mobile       String?       @db.VarChar(20)

  /// Gravité du problème — nomenclature, et non plus un entier libre.
  /// Entier, comme la clé qu'il référence.
  idDegreRapport Int?
  degre          DegreRapport?  @relation(fields: [idDegreRapport], references: [idDegreRapport], onDelete: SetNull)
  /// Nature du problème — nomenclature, avec sa couleur d'affichage.
  idNature       Int?           @db.SmallInt
  nature         NatureRapport? @relation(fields: [idNature], references: [idNature], onDelete: SetNull)
  /// Avancement du traitement.
  /// État, et non information optionnelle : non traité par défaut.
  traiter        Int            @default(0) @db.SmallInt
  /// Déplacé depuis `customerChat` : une session peut se terminer sans que la
  /// réclamation soit résolue, les deux notions ne se confondent pas.
  is_resolve     Boolean        @default(false)

  /// `start_time` remplace l'ancien `date` : le modèle mesure une DURÉE de
  /// traitement, pas un instant de création. `end_time` nul = en cours.
  start_time DateTime  @default(now()) @db.Timestamptz
  end_time   DateTime? @db.Timestamptz

  idAgence  Int?
  agence    Agence?  @relation(fields: [idAgence], references: [idAgence], onDelete: SetNull)
  idService Int?
  service   Service? @relation(fields: [idService], references: [idService], onDelete: SetNull)

  /// Conservé de l'état précédent : la colonne existe et rien ne l'utilise. Le
  /// modèle tidesk ne la reprend pas — à supprimer si l'équipe confirme.
  type Int? @db.SmallInt

  docs              DocRapport[]
  transferts        Transferer[]
  bordereauxService BordereauService[]
  bordereauxAgent   BordereauAgent[]
  commentaires      Commentaire[]

  @@index([idCustomer], map: "rapportChat_idCustomer_idx")
  /// Les rapports d'un agent, du plus récent au plus ancien.
  @@index([idAgent], map: "rapportChat_idAgent_idx")
  @@index([idService], map: "rapportChat_idService_idx")
  @@index([idAgence], map: "rapportChat_idAgence_idx")
  @@map("rapportChat")
}

/// Pièce jointe d'un rapport (document, capture, enregistrement).
model DocRapport {
  idDoc     Int         @id @default(autoincrement())
  idRapport Int
  rapport   RapportChat @relation(fields: [idRapport], references: [idRap], onDelete: Cascade)
  /// `Text` et non `VarChar(150)` comme le modèle : les URL de médias signées
  /// dépassent régulièrement 150 caractères. Écart assumé.
  url       String      @db.Text
  upload_at DateTime    @default(now()) @db.Timestamptz
  typeMedia Int?        @db.SmallInt

  @@index([idRapport], map: "docRapport_idRapport_idx")
  @@map("docRapport")
}

/// Nomenclature des degrés de gravité d'un rapport.
///
/// `libelleAn` est le libellé anglais — nom repris du modèle tidesk. Il diffère
/// de `Pays.libelleAnglais`, écrit en toutes lettres : l'incohérence vient du
/// modèle, elle est signalée plutôt que corrigée unilatéralement.
model DegreRapport {
  idDegreRapport Int     @id @default(autoincrement()) @db.SmallInt
  libelle        String  @db.VarChar(45)
  libelleAn      String? @db.VarChar(45)

  rapportsChat RapportChat[]

  @@map("degreRapport")
}

/// Nomenclature des natures de rapport, avec la couleur qui les distingue
/// dans l'interface (ex. « #C56A42 »).
model NatureRapport {
  idNature    Int     @id @default(autoincrement()) @db.SmallInt
  libelle     String  @db.VarChar(45)
  libelleAn   String? @db.VarChar(45)
  codeCouleur String? @db.VarChar(10)

  rapportsChat RapportChat[]

  @@map("natureRapport")
}

/// Nomenclature des types d'entreprise, référencée par [Company].
model TypeCompany {
  idTypeCompany Int     @id @default(autoincrement())
  libelle       String  @db.VarChar(45)
  libelleAn     String? @db.VarChar(45)

  companies Company[]

  @@map("typeCompany")
}

/// Passage d'un rapport d'un service à un autre.
///
/// Une ligne par transfert : le parcours complet se lit en triant sur
/// `sent_at`, sans qu'aucune information soit écrasée.
model Transferer {
  idTrans            Int         @id @default(autoincrement())
  idService_sender   Int?
  serviceSender      Service?    @relation("TransfertEmetteur", fields: [idService_sender], references: [idService], onDelete: SetNull)
  idService_receiver Int?
  serviceReceiver    Service?    @relation("TransfertDestinataire", fields: [idService_receiver], references: [idService], onDelete: SetNull)
  sent_at            DateTime    @default(now()) @db.Timestamptz
  idRapport          Int
  rapport            RapportChat @relation(fields: [idRapport], references: [idRap], onDelete: Cascade)

  /// Qui a transféré, et pourquoi. Le transfert ne retenait que les services :
  /// on savait d'où venait un rapport et où il allait, jamais qui l'avait
  /// déplacé ni pour quel motif. SetNull, pour que le départ de l'agent ne
  /// fasse pas disparaître le transfert lui-même.
  idAgent     String? @db.Uuid
  agent       User?   @relation("TransfertAgent", fields: [idAgent], references: [id], onDelete: SetNull)
  commentaire String? @db.Text

  @@index([idRapport, sent_at], map: "transferer_idRapport_idx")
  @@map("transferer")
}

/// Temps passé sur un rapport PAR SERVICE. `end_time` nul = en cours.
model BordereauService {
  idBordService Int         @id @default(autoincrement())
  idRapport     Int
  rapport       RapportChat @relation(fields: [idRapport], references: [idRap], onDelete: Cascade)
  idService     Int?
  service       Service?    @relation(fields: [idService], references: [idService], onDelete: SetNull)
  start_time    DateTime    @default(now()) @db.Timestamptz
  end_time      DateTime?   @db.Timestamptz

  @@index([idRapport], map: "bordereauService_idRapport_idx")
  @@index([idService], map: "bordereauService_idService_idx")
  @@map("bordereauService")
}

/// Temps passé sur un rapport PAR AGENT. `end_time` nul = en cours.
model BordereauAgent {
  idbordAgent Int         @id @default(autoincrement())
  idRapport   Int
  rapport     RapportChat @relation(fields: [idRapport], references: [idRap], onDelete: Cascade)
  idAgent     String?     @db.Uuid
  /// SetNull : retirer un agent ne doit plus emporter ses bordereaux.
  agent       User?       @relation(fields: [idAgent], references: [id], onDelete: SetNull)
  start_time  DateTime    @default(now()) @db.Timestamptz
  end_time    DateTime?   @db.Timestamptz

  commentaires Commentaire[]

  @@index([idRapport], map: "bordereauAgent_idRapport_idx")
  /// Ramené à la seule colonne d'agent : on cherche les bordereaux D'UN agent,
  /// jamais l'ensemble trié par date.
  @@index([idAgent], map: "bordereauAgent_idAgent_idx")
  @@map("bordereauAgent")
}

/// Commentaire interne sur un rapport.
///
/// `idBordAgent` est nullable : un commentaire peut porter sur le rapport
/// entier sans être rattaché au passage d'un agent particulier.
model Commentaire {
  idCom       Int             @id @default(autoincrement())
  idBordAgent Int?
  /// SetNull : le bordereau peut disparaître, le commentaire reste.
  bordAgent   BordereauAgent? @relation(fields: [idBordAgent], references: [idbordAgent], onDelete: SetNull)
  idRapport   Int
  rapport     RapportChat     @relation(fields: [idRapport], references: [idRap], onDelete: Cascade)
  /// Obligatoire : un commentaire vide n'a pas de sens.
  content     String          @db.Text
  created_at  DateTime        @default(now()) @db.Timestamptz

  @@index([idRapport, created_at], map: "commentaire_idRapport_idx")
  @@index([idBordAgent], map: "commentaire_idBordAgent_idx")
  @@map("commentaire")
}

// Jetons FCM (Firebase Cloud Messaging) pour notifications push mobile/web.
model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @db.VarChar(512)
  platform  String   @db.VarChar(16) // android | ios | web
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  /// Appareil qui a obtenu ce jeton — même identifiant que
  /// `Appareil.cookies_WebID`.
  ///
  /// ⚠️ Sans lui, l'envoi ne pouvait cibler qu'un COMPTE : un téléphone
  /// déconnecté ou évincé continuait de recevoir messages et appels, parce que
  /// rien en base ne disait quel jeton lui appartenait. Nul pour les
  /// enregistrements antérieurs, traités comme « appareil indéterminé ».
  deviceId String? @map("device_id") @db.VarChar(255)

  @@index([userId])
  /// Sert la déconnexion et l'éviction : retrouver les jetons d'un appareil.
  @@index([userId, deviceId], map: "push_devices_user_device_idx")
  @@map("push_devices")
}

// Codes de vérification email (OTP 6 chiffres) — envoyés via Firebase/email
model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  codeHash  String // hash du code OTP à 6 chiffres (jamais en clair)
  expiresAt DateTime @db.Timestamptz
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([email])
  @@map("email_verifications")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String // hash du refresh token
  expiresAt DateTime @db.Timestamptz
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  /// Appareil ayant obtenu cette session — même identifiant que
  /// `Appareil.cookies_WebID`. C'est ce lien qui rend la déconnexion à
  /// distance possible : sans lui, on sait à quel utilisateur appartient un
  /// jeton, pas depuis quel appareil il a été émis.
  ///
  /// Nul pour les sessions ouvertes avant cette évolution, et pour les clients
  /// qui ne l'envoient pas : elles restent valides, simplement non révocables
  /// individuellement.
  deviceId String? @map("device_id") @db.VarChar(255)

  /// Pourquoi ce jeton a été révoqué. `null` = par la rotation ordinaire,
  /// `"evicted"` = par l'ouverture d'une session sur un autre appareil de la
  /// même famille.
  ///
  /// ⚠️ Sans cette distinction, le message serait FAUX : la rotation révoque
  /// l'ancien jeton à chaque rafraîchissement, donc un simple réessai après une
  /// réponse perdue afficherait « votre compte a été ouvert sur un autre
  /// appareil ». Elle sert aussi l'appareil qui était HORS LIGNE au moment de
  /// l'éviction — le seul cas que l'événement temps réel ne peut pas couvrir.
  revokedReason String? @map("revoked_reason") @db.VarChar(20)

  @@index([userId])
  /// Sert la révocation : retrouver les sessions d'un appareil donné.
  @@index([userId, deviceId], map: "refresh_tokens_user_device_idx")
  @@map("refresh_tokens")
}

model Contact {
  id        String   @id @default(uuid()) @map("idPrefContact") @db.Uuid
  userId    String   @map("alanyaID") @db.Uuid
  contactId String   @map("idFriend") @db.Uuid
  user      User     @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contact   User     @relation("ContactOf", fields: [contactId], references: [id], onDelete: Cascade)
  alias     String?  @db.VarChar(100) // extra local : nom donné par l'utilisateur dans son répertoire
  isBlocked Boolean  @default(false) // extra local
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, contactId])
  @@index([userId])
  @@map("preferredContact")
}

// ---------------------------------------------------------------------------
// LISTES DE CONTACTS
// ---------------------------------------------------------------------------

/// Regroupement nomme de contacts, prive au compte qui l'a cree.
///
/// Repond a deux besoins qu'un groupe de discussion ne couvre pas : diffuser
/// vers plusieurs personnes sans creer de conversation commune entre elles, et
/// reconnaitre a l'oreille une categorie d'appelants — la famille, l'equipe
/// d'astreinte. C'est pourquoi la sonnerie est portee par la liste et non par
/// chaque fiche contact.
model ContactList {
  id     String @id @default(uuid()) @map("idContactList") @db.Uuid
  userId String @map("alanyaID") @db.Uuid
  user   User   @relation("UserContactLists", fields: [userId], references: [id], onDelete: Cascade)

  name String @map("libelle") @db.VarChar(80)

  /// Sonnerie : SOIT un nom de fichier livre avec le client
  /// («incoming_ring.mp3»), SOIT une URL de media relative («/api/media/<id>»)
  /// quand l'utilisateur televerse la sienne. Chaine libre a dessein : une
  /// enumeration ne couvrirait que le premier cas et imposerait une migration a
  /// chaque son ajoute au client. L'espace de noms est deja tenu une seule fois,
  /// cote client (src/services/ringtones.ts) ; le redoubler ici donnerait deux
  /// verites a maintenir.
  ringtone String? @db.VarChar(300)

  /// Pastille de couleur telle que le client l'ecrit («#FF7A00»). Non validee,
  /// pour la meme raison que la sonnerie : la palette appartient au client.
  color String? @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members ContactListMember[]

  /// Le nom est l'identite visible d'une liste : deux homonymes chez le meme
  /// compte seraient indiscernables a l'ecran.
  @@unique([userId, name])
  @@index([userId])
  @@map("contactList")
}

/// Appartenance d'un contact a une liste.
model ContactListMember {
  id     String      @id @default(uuid()) @map("idContactListMember") @db.Uuid
  listId String      @map("idContactList") @db.Uuid
  list   ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  /// Le membre designe un COMPTE, pas une ligne de repertoire : retirer puis
  /// re-ajouter la personne a ses contacts ne doit pas vider les listes ou elle
  /// figure.
  memberId String @map("idFriend") @db.Uuid
  member   User   @relation("ContactListMemberOf", fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([listId, memberId])
  @@index([listId])
  @@map("contactListMember")
}

// ---------------------------------------------------------------------------
// CATALOGUE DE SONNERIES
// ---------------------------------------------------------------------------

/// Une sonnerie importee par un utilisateur — l'ENTREE DE CATALOGUE, pas le son.
///
/// POURQUOI cette table. Le fichier, lui, suivait deja le compte : il part par
/// POST /api/media et devient une ligne de `media_files`. Ce qui ne suivait pas,
/// c'est la liste de ce qu'on a importe, tenue en localStorage sous
/// `alanya-ringtones-custom-v1`. D'ou le defaut constate : une sonnerie importee
/// sur l'ordinateur et attribuee a la liste « Clients » SONNE bien sur le
/// telephone — la reference est en base, portee par [ContactList.ringtone] —
/// mais elle n'apparait pas dans le choix quand on veut l'attribuer a une
/// seconde liste depuis le telephone. Il faudrait la reimporter, ce qui creerait
/// un doublon sur le serveur pour le meme son.
///
/// CE QUI RESTE HORS DE CETTE TABLE, deliberatement : le CHOIX de sonnerie pour
/// les evenements globaux (appel entrant, sortant, message), garde cote client
/// dans `alanya-ringtone-incoming` / `-outgoing` / `-message`. C'est une
/// preference d'APPAREIL, au meme titre que le theme ou le volume : on peut
/// vouloir un son discret au bureau et fort sur son telephone. Seul le catalogue
/// devient commun.
model UserRingtone {
  id     String @id @default(uuid()) @map("idUserRingtone") @db.Uuid
  userId String @map("alanyaID") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// URL relative du media deja televerse, de la forme «/api/media/<id>».
  ///
  /// Une CHAINE et non une cle etrangere vers `media_files`. Deux raisons. C'est
  /// d'abord la valeur exacte que [ContactList.ringtone] porte deja : la meme
  /// forme de part et d'autre, donc rien a recomposer pour comparer une entree
  /// de catalogue a la sonnerie d'une liste. Ensuite, une FK imposerait ici la
  /// meme decision de cascade que la-bas, ou `ringtone` est libre : le catalogue
  /// peut donc citer un media efface, exactement comme une liste le peut. Voir
  /// l'en-tete de la migration 20260819 pour ce que cela implique.
  ///
  /// VARCHAR(300) comme [ContactList.ringtone], et pas une autre largeur : la
  /// meme valeur transite d'une colonne a l'autre, une borne plus etroite ici
  /// refuserait ce que la liste accepte.
  url String @db.VarChar(300)

  /// Nom montre dans le choix de sonnerie — en general celui du fichier importe.
  /// Coupe a 80 caracteres cote serveur, jamais refuse : un nom trop long est une
  /// maladresse, pas une requete invalide.
  label String @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// Le catalogue est un ENSEMBLE de medias, pas un journal d'imports :
  /// reimporter le meme fichier renomme la ligne existante au lieu d'en ajouter
  /// une seconde, sinon le choix de sonnerie afficherait deux fois le meme son.
  @@unique([userId, url])
  @@index([userId])
  @@map("userRingtone")
}

// ---------------------------------------------------------------------------
// MESSAGERIE
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(uuid()) @map("conversID") @db.Uuid
  isGroup   Boolean  @default(false)
  name      String?  @map("GroupName") @db.VarChar(150) // nom du groupe (null pour les conversations directes)
  avatarUrl String?  @map("groupPhoto")
  createdAt DateTime @default(now()) @db.Timestamptz // extra local
  updatedAt DateTime @updatedAt @db.Timestamptz // extra local

  participants Participant[]
  messages     Message[]
  locks        ConversationLock[]

  // --- F11 : Dernier message dénormalisé ---
  lastMessage         String?   @db.Text
  lastMessageAt       DateTime? @db.Timestamptz
  lastMessageSenderID String?   @db.Uuid
  lastMessageType     Int?      @db.SmallInt
  lastMessageStatus   Int?      @db.SmallInt

  // Message épinglé (partagé à toute la conversation). Null = aucun. Pas de FK :
  // si le message est supprimé pour tous il reste consultable (deletedAt), et on
  // filtre à la lecture au besoin.
  pinnedMessageId String? @map("pinned_message_id") @db.Uuid

  // Messages éphémères : durée de vie (en secondes) des NOUVEAUX messages.
  // 0 = désactivé. Les valeurs usuelles : 86400 (24h), 604800 (7j), 7776000 (90j).
  disappearingSeconds Int @default(0) @map("disappearing_seconds")

  @@map("conversation")
}

enum ParticipantRole {
  MEMBER
  ADMIN
}

model Participant {
  id         String          @id @default(uuid()) @db.Uuid
  convId     String          @map("conversID") @db.Uuid
  userId     String          @map("alanyaID") @db.Uuid
  conv       Conversation    @relation(fields: [convId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ParticipantRole @default(MEMBER) // extra local
  joinedAt   DateTime        @default(now()) @db.Timestamptz
  // Pointeur de lecture pour calculer les non-lus (extra local)
  lastReadAt DateTime?       @db.Timestamptz

  // --- F8 : Épingler ---
  isPinned Int @default(0) @db.SmallInt

  // --- F9 : Archiver ---
  isArchived Int @default(0) @db.SmallInt

  // --- F10 : Compteur de non-lus ---
  unreadCount Int @default(0) @db.SmallInt

  @@unique([convId, userId])
  @@index([userId])
  @@map("conv_participants")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO // message vocal
  VIDEO
  SYSTEM
  /// Fiche de contact partagée. La charge est du JSON dans `content` —
  /// voir `src/lib/message-payload.mjs`, qui tient le format pour les trois
  /// clients. La photo éventuelle du contact est un média du message.
  CONTACT
  /// Position GPS partagée. Charge JSON dans `content` (même module).
  LOCATION
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Message {
  id         String            @id @default(uuid()) @map("msgID") @db.Uuid
  convId     String            @map("conversationID") @db.Uuid
  senderId   String            @map("senderID") @db.Uuid
  conv       Conversation      @relation(fields: [convId], references: [id], onDelete: Cascade)
  sender     User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  /// Texte du message, `null` pour un média sans légende.
  ///
  /// 🔴 VARCHAR(500) DEPUIS LE 25/08/2026, plus `TEXT`
  /// (`prisma/manual/2026-08_message_content_varchar500.sql`).
  ///
  /// ⚠️ PostgreSQL REFUSE une valeur plus longue (erreur 22001), il ne la coupe
  /// pas. Toute écriture doit donc passer par `tronqueContenu` de
  /// `src/lib/message-payload.mjs` — c'est elle qui coupe le texte et qui
  /// REFUSE une charge CONTACT/LOCATION trop longue, dont le JSON ne survivrait
  /// pas à une coupe.
  content    String?           @db.VarChar(500)
  /// Appareil qui a envoyé le message, quand le client l'a indiqué.
  ///
  /// `senderId` dit quel COMPTE a écrit ; cette colonne dit lequel de ses
  /// appareils — un numéro professionnel peut être partagé entre plusieurs
  /// agents. Elle sert à afficher le pseudo de l'appareil au-dessus du message,
  /// et UNIQUEMENT aux appareils du même compte.
  ///
  /// Nullable : tout l'historique existant n'en a pas, et un client qui ne
  /// l'envoie pas reste valide. Pas de clé étrangère — la ligne d'appareil peut
  /// disparaître sans emporter les messages déjà envoyés.
  appareilId Int?              @map("appareilID")
  type       MessageType       @default(TEXT)
  status     MessageStatus     @default(SENT)
  replyToId  String?           @map("replyToID") @db.Uuid
  replyTo    Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies    Message[]         @relation("MessageReplies")
  media      MediaFile[]
  createdAt  DateTime          @default(now()) @map("sendAt") @db.Timestamptz
  editedAt   DateTime?         @db.Timestamptz
  // Message éphémère : instant d'expiration (null = permanent). Purgé après.
  expiresAt  DateTime?         @map("expires_at") @db.Timestamptz
  deletedAt  DateTime?         @db.Timestamptz // extra local (le réf. utilise isDeleted/deletedForID)
  hides      MessageHide[]
  reactions  MessageReaction[]
  stars      MessageStar[]

  @@index([convId, createdAt])
  @@index([senderId])
  @@index([appareilId])
  /// Balayage des messages ephemeres arrives a echeance. Existait en base sans
  /// etre declare ici : supprime par un `db push` le 06/08/2026.
  @@index([expiresAt])
  @@map("message")
}

// Messages favoris (étoile). Privé à chaque utilisateur (comme WhatsApp) :
// une ligne = « cet utilisateur a mis ce message en favori ». onDelete Cascade.
model MessageStar {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_stars")
}

// Réactions emoji (extra local). Une seule réaction par utilisateur et par
// message (@@unique) : réagir à nouveau remplace l'emoji, réagir avec le même
// emoji le retire (géré côté handler). onDelete: Cascade nettoie automatiquement.
model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

// Suppression « pour moi » : enregistre qu'un utilisateur a masqué un message
// de sa vue (les autres participants le voient toujours). @@unique empêche les
// doublons ; onDelete: Cascade nettoie automatiquement si l'utilisateur ou le
// message est supprimé.
model MessageHide {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  messageId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([userId, messageId])
  @@index([userId])
  @@map("message_hides")
}

// ---------------------------------------------------------------------------
// MÉDIAS (binaires sur disque, métadonnées en base)
// ---------------------------------------------------------------------------

model MediaFile {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @db.Uuid
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messageId    String?  @db.Uuid
  message      Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  filename     String
  mimeType     String
  sizeBytes    Int
  url          String // chemin/URL d'accès (le binaire est stocké hors BD)
  thumbnailUrl String?
  durationMs   Int? // pour audio/vidéo (messages vocaux, appels)
  createdAt    DateTime @default(now()) @db.Timestamptz

  /// Une plainte vocale s'appuie sur ce média. `Cascade` : supprimer le fichier
  /// retire la plainte, qui n'aurait plus rien à faire écouter.
  plainteVocale VoiceComplaint[]
  /// Les trois rôles qu'un média peut tenir dans un enregistrement d'appel.
  enregistrementPisteAgent  CallRecording[] @relation("enregistrementPisteAgent")
  enregistrementPisteClient CallRecording[] @relation("enregistrementPisteClient")
  enregistrementMelange     CallRecording[] @relation("enregistrementMelange")

  @@index([ownerId])
  @@index([messageId])
  @@map("media_files")
}

// ---------------------------------------------------------------------------
// STATUTS (stories éphémères, 24 h)
// ---------------------------------------------------------------------------

enum StatusType {
  TEXT
  IMAGE
  VIDEO
}

model Status {
  id        String     @id @default(uuid()) @map("ID") @db.Uuid
  userId    String     @map("alanyaID") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      StatusType @default(TEXT)
  text      String?    @db.VarChar(700)
  mediaUrl  String?
  bgColor   String?    @map("backgroundColor") @db.VarChar(9) // couleur de fond pour les statuts texte
  createdAt DateTime   @default(now()) @db.Timestamptz
  expiresAt DateTime   @map("expiredAt") @db.Timestamptz // createdAt + 24 h

  views StatusView[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("statut")
}

model StatusView {
  id       String   @id @default(uuid()) @db.Uuid
  statusId String   @map("statutID") @db.Uuid
  viewerId String   @map("alanyaID") @db.Uuid
  status   Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now()) @map("seenAt") @db.Timestamptz

  @@unique([statusId, viewerId])
  @@map("statut_views")
}

// ---------------------------------------------------------------------------
// APPELS (WebRTC : signaling + métadonnées)
// ---------------------------------------------------------------------------

enum CallType {
  AUDIO
  VIDEO
}

/// Statuts d'appel. Chaque valeur décrit un FAIT objectif, jamais un point de
/// vue : un refus est un seul événement, que l'appelant lit « refusé » et
/// l'appelé « rejeté ». Cette formulation par destinataire est calculée à la
/// lecture par `libelleAppel()`, elle n'est pas stockée — sinon il faudrait
/// écrire deux lignes pour le même fait, et c'est exactement la confusion qui
/// faisait afficher « Rejeté » des deux côtés.
///
/// ⚠️ Une valeur d'enum PostgreSQL ne se RETIRE pas : il faudrait recréer le
/// type et réécrire toutes les colonnes qui l'utilisent, sur des données de
/// prod. Tout ajout ici est définitif.
enum CallStatus {
  RINGING
  ONGOING
  ENDED
  /// Conservé pour l'historique : les appels créés avant l'ajout de NO_ANSWER
  /// portent cette valeur. Le nouveau code écrit NO_ANSWER, jamais MISSED, et
  /// `libelleAppel()` traite les deux à l'identique.
  MISSED
  REJECTED
  /// Personne n'a décroché — ni raccroché par l'appelant, ni refusé par
  /// l'appelé. Remplace le `ENDED` que posait `end/route.ts` quand l'appelant
  /// abandonnait, et qui obligeait le client à deviner via `durationSec == 0`.
  NO_ANSWER
  /// L'appelé était déjà en ligne. L'appel n'a jamais sonné chez lui.
  BUSY
}

model Call {
  id          String     @id @default(uuid()) @db.Uuid
  initiatorId String     @db.Uuid
  initiator   User       @relation("CallInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  convId      String?    @db.Uuid
  type        CallType   @default(AUDIO)
  status      CallStatus @default(RINGING)
  startedAt   DateTime   @default(now()) @db.Timestamptz
  answeredAt  DateTime?  @db.Timestamptz
  endedAt     DateTime?  @db.Timestamptz

  /// Identité à MONTRER À L'APPELÉ, ajouté le 15/08/2026 pour le rappel « sous
  /// le nom du centre » (`/api/queue/callback`) : un agent rappelle un client
  /// abandonné, mais le client doit voir le centre, pas l'agent. `initiatorId`
  /// reste le VRAI agent — il porte toute la sécurité (verrous, sonnerie,
  /// historique CÔTÉ AGENT) sans le moindre changement ; seule la vue offerte
  /// au CALLÉ substitue cette identité à la sienne. Nul pour tout appel
  /// ordinaire, y compris l'IVR entrant (qui masque déjà autrement, via un
  /// vrai `callParticipant` centre — voir `serialiseAppelPour`).
  callerMaskId String? @db.Uuid
  callerMask   User?   @relation("CallCallerMask", fields: [callerMaskId], references: [id], onDelete: SetNull)

  participants CallParticipant[]
  /// ⚠️ `SetNull` et non `Cascade` : une purge des appels ne doit pas emporter
  /// des enregistrements que l'entreprise est censée conserver.
  enregistrements CallRecording[]

  @@index([initiatorId])
  @@map("calls")
}

model CallParticipant {
  id       String    @id @default(uuid()) @db.Uuid
  callId   String    @db.Uuid
  userId   String    @db.Uuid
  call     Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime? @db.Timestamptz
  leftAt   DateTime? @db.Timestamptz

  @@unique([callId, userId])
  @@map("call_participants")
}

