// ===========================================================================
// NOUVEAUX MODÈLES — Schéma PDF cible
// ===========================================================================

// ---------------------------------------------------------------------------
// PAYS (référentiel pays — source de vérité pour les indicatifs & fuseaux)
// ---------------------------------------------------------------------------

model Pays {
  idPays          Int    @id @default(autoincrement()) @db.SmallInt // MySQL smallint → PG SMALLINT
  libelle         String @db.VarChar(100)
  /// Libellé anglais du pays. NOT NULL avec défaut vide : les lignes déjà
  /// semées n'en ont pas, et la colonne s'ajoute sans réécrire la table.
  libelleAnglais  String @default("") @db.VarChar(100)
  /// Code ISO 3166-1 alpha-2 (CM, FR, SN…).
  ///
  /// C'est lui qui permet aux clients de traduire le nom du pays dans les neuf
  /// langues sans qu'on stocke neuf libellés : `Intl.DisplayNames` sur le web,
  /// équivalent natif sur mobile. Nullable — un pays sans code s'affiche avec
  /// son `libelle`, comme avant.
  iso2            String? @db.Char(2)
  prefix          String @default("") @db.VarChar(10) // indicatif téléphonique (+237, +33…)
  timeZone        String @default("Africa/Dakar") @db.VarChar(200) // ex: "Africa/Douala"
  decalageHoraire Int    @default(0)

  users User[]

  // Relations inverses vers les tables du volet organisation. Purement
  // virtuelles : aucune colonne ajoutée à `pays`.
  villes          Ville[]
  adminRoots      AdminRoot[]
  companies       Company[]
  prixAbonnements PrixAbonnement[]

  isDelete Boolean @default(false) @map("isDelete")

  @@map("pays")
}

// ---------------------------------------------------------------------------
// MEETINGS (réunions audio/vidéo planifiées)
// ---------------------------------------------------------------------------

model Meeting {
  idMeeting   Int      @id @default(autoincrement()) // MySQL int → PG INTEGER
  idOrganiser String   @db.Uuid
  organiser   User     @relation("MeetingOrganizer", fields: [idOrganiser], references: [id], onDelete: Cascade)
  start_time  DateTime @default(now()) @db.Timestamptz // MySQL datetime → PG TIMESTAMPTZ
  duree       Int      @default(0) // MySQL int → PG INTEGER (secondes)
  objet       String   @default("Réunion") @db.VarChar(200) // MySQL varchar(200)
  room        String   @default("default-room") @db.VarChar(200) // MySQL varchar(200)
  isEnd       Int      @default(0) @db.SmallInt // MySQL tinyint → PG SMALLINT
  type_media  Int      @default(1) @db.SmallInt // MySQL tinyint → PG SMALLINT (1=audio, 2=vidéo)
  invitationAuto Int @default(0) @db.SmallInt @map("invitation_auto")

  participants MeetingParticipant[]
  rappel       MeetingRappel?
  demandes     MeetingInviteRequest[]

  @@index([idOrganiser])
  @@map("meeting")
}

/// Demande d'un participant pour faire entrer quelqu'un dans une réunion.
///
/// Tant que l'organisateur n'a pas tranché, la personne proposée n'existe pas
/// pour la réunion : elle n'est pas dans `participant` et n'apprend RIEN.
///
/// ⚠️ L'unicité porte sur (idMeeting, invite) et NON sur le demandeur : c'est
/// elle qui applique la règle « un refus est définitif ». La ligne refusée reste
/// et bloque toute nouvelle demande concernant cette personne, quel que soit
/// celui qui la formule — sans quoi un participant refusé n'aurait qu'à faire
/// redemander par un collègue.
model MeetingInviteRequest {
  id            Int       @id @default(autoincrement())
  idMeeting     Int
  meeting       Meeting   @relation(fields: [idMeeting], references: [idMeeting], onDelete: Cascade)
  demandeurId   String    @map("demandeur") @db.Uuid
  demandeur     User      @relation("MeetingRequestAuthor", fields: [demandeurId], references: [id], onDelete: Cascade)
  inviteId      String    @map("invite") @db.Uuid
  invite        User      @relation("MeetingRequestInvitee", fields: [inviteId], references: [id], onDelete: Cascade)
  /// 0 = en attente, 1 = acceptée, 2 = refusée.
  statut        Int       @default(0) @db.SmallInt
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz

  @@unique([idMeeting, inviteId], map: "meeting_invite_request_unique")
  @@index([idMeeting, statut], map: "meeting_invite_request_meeting_statut_idx")
  @@map("meeting_invite_request")
}

/// Rappel des 5 minutes DÉJÀ ENVOYÉ pour une réunion.
///
/// L'existence de la ligne porte toute l'information : il n'y a pas de booléen
/// à tenir. La clé primaire étant l'identifiant de la réunion, deux balayages
/// simultanés ne peuvent pas produire deux rappels — la seconde insertion
/// échoue. C'est la contrainte qui garantit l'unicité, pas un verrou applicatif.
///
/// Table à NOUS, et non une colonne ajoutée à `meeting` : ce modèle-là vient du
/// référentiel de l'équipe, et cette information ne les concerne pas.
model MeetingRappel {
  idMeeting Int      @id
  meeting   Meeting  @relation(fields: [idMeeting], references: [idMeeting], onDelete: Cascade)
  envoyeA   DateTime @default(now()) @db.Timestamptz

  @@map("meeting_rappel")
}

model MeetingParticipant {
  ID            Int       @id @default(autoincrement()) // MySQL int → PG INTEGER
  idMeeting     Int // MySQL int → PG INTEGER
  meeting       Meeting   @relation(fields: [idMeeting], references: [idMeeting], onDelete: Cascade)
  IDparticipant String    @db.Uuid
  user          User      @relation("MeetingParticipantUser", fields: [IDparticipant], references: [id], onDelete: Cascade)
  status        Int       @default(0) @db.SmallInt // MySQL tinyint → PG SMALLINT (0=invité, 1=accepté, 2=décliné)
  start_time    DateTime? @db.Timestamptz // MySQL datetime → PG TIMESTAMPTZ
  connecte      Int       @default(0) @db.SmallInt // MySQL tinyint → PG SMALLINT (0=déconnecté, 1=connecté)
  duree         Int? // MySQL int → PG INTEGER (secondes)

  @@unique([idMeeting, IDparticipant])
  @@index([IDparticipant])
  @@map("participant")
}

// ---------------------------------------------------------------------------
// LIMITE_REUNION — plafond de participants, par portee
// ---------------------------------------------------------------------------

/// Plafond de participants d'une reunion : combien de personnes peuvent tenir
/// dans une meme salle, en audio et en video.
///
/// CE N'EST PAS UNE REGLE COMMERCIALE. Les reunions sont en MAILLAGE : chaque
/// participant ouvre une connexion vers chacun des autres et encode son flux
/// autant de fois qu'il a d'interlocuteurs. Le cout par machine croit donc
/// lineairement avec l'assemblee, pour chacun. Au-dela du plafond, ce ne sont
/// pas les serveurs qui saturent — ils ne voient rien passer — mais les
/// telephones et les ordinateurs des participants. Le plafond est une borne
/// PHYSIQUE ; les valeurs raisonnables sont 9 en audio et 6 en video, et c'est
/// ce que porte la ligne globale posee par la migration.
///
/// PORTEE. `idCompany` NUL = la ligne GLOBALE, qui vaut pour toute
/// l'application ; renseigne = le plafond propre a une entreprise, qui prime
/// sur la globale pour ses utilisateurs. Deux niveaux suffisent : il n'existe
/// aucun echelon entre l'entreprise et l'application.
///
/// UNICITE DE LA PORTEE — deux verites pour une meme portee rendraient le
/// plafond indeterminable. `@unique` sur `idCompany` regle le cas des
/// entreprises. Il NE REGLE PAS celui de la ligne globale : PostgreSQL
/// considere deux NULL comme distincts et accepterait donc autant de lignes
/// globales qu'on en insere. La garantie manquante est posee a la main dans la
/// migration, par un index unique PARTIEL sur `WHERE "idcompany" IS NULL`, que
/// le langage de schema Prisma ne sait pas exprimer.
/// ⚠️ Cet index n'etant pas declare ici, un `prisma migrate dev` ou un
/// `db push` le verra comme une derive et voudra le supprimer. Il doit etre
/// repose s'il disparait.
///
/// TRACE. `modifiePar` et `updatedAt` disent QUI a change le plafond et QUAND.
/// Sans eux, on decouvre en production une salle qui refuse du monde a 4 sans
/// pouvoir remonter a la decision. `modifiePar` est du TEXTE LIBRE et non une
/// cle etrangere vers `adminroot` : il n'existe aujourd'hui aucune session de
/// superuser dans ce depot (voir `src/lib/limites-reunion.ts`), l'auteur n'est
/// donc pas authentifie mais DECLARE par l'appelant. Une cle etrangere
/// affirmerait une certitude que nous n'avons pas.
///
/// Ligne unique par entreprise, sans historique : c'est l'ETAT du plafond, pas
/// son journal. Le jour ou il faudra l'historique, il ira dans une table a
/// part plutot que de dedoubler la verite dans celle-ci.
model LimiteReunion {
  idLimite Int @id @default(autoincrement()) @map("idlimite")

  /// NUL = portee globale. Cascade : une entreprise supprimee emporte son
  /// plafond, qui n'a plus personne a borner ; ses utilisateurs, eux, sont
  /// detaches (`users.idcompany` passe a NULL) et retombent sur la globale.
  idCompany Int?     @unique @map("idcompany")
  company   Company? @relation(fields: [idCompany], references: [idCompany], onDelete: Cascade, onUpdate: Cascade)

  /// Participants maximum, ORGANISATEUR COMPRIS — c'est le nombre de personnes
  /// dans la salle, pas le nombre d'invites.
  maxAudio Int @default(9) @map("max_audio") @db.SmallInt
  maxVideo Int @default(6) @map("max_video") @db.SmallInt

  /// Auteur DECLARE du dernier changement (voir plus haut : non authentifie).
  modifiePar String?  @map("modifie_par") @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("limite_reunion")
}

// ---------------------------------------------------------------------------
// BLOCKED (utilisateurs bloqués — indépendant de Contact.isBlocked)
// ---------------------------------------------------------------------------

model Blocked {
  idBlock       Int      @id @default(autoincrement()) // MySQL int → PG INTEGER
  alanyaID      String   @db.Uuid
  owner         User     @relation("BlockOwner", fields: [alanyaID], references: [id], onDelete: Cascade)
  idCallerBlock String   @db.Uuid
  blockedUser   User     @relation("BlockedUser", fields: [idCallerBlock], references: [id], onDelete: Cascade)
  dateBlock     DateTime @default(now()) @db.Timestamptz // MySQL datetime → PG TIMESTAMPTZ

  @@unique([alanyaID, idCallerBlock])
  @@index([alanyaID])
  @@map("blocked")
}

// ---------------------------------------------------------------------------
// CONVERSATION_LOCK — reservation d'une conversation par UN appareil
// ---------------------------------------------------------------------------

/// Verrou de conversation, pose par un appareil pour un compte.
///
/// Cas d'usage : un numero professionnel partage entre plusieurs agents. Celui
/// qui prend la main sur une discussion la reserve, et les autres appareils du
/// MEME compte ne peuvent plus y ecrire.
///
/// Le verrou n'isole pas : les autres appareils continuent de recevoir en
/// temps reel tout ce que l'agent envoie et recoit. Ils perdent le droit
/// d'ecrire, rien d'autre — aucune diffusion de message ne doit le consulter.
///
/// A ne pas confondre avec `Blocked` : bloquer empeche les messages d'un TIERS
/// d'arriver ; verrouiller repartit l'ecriture entre SES PROPRES appareils.
model ConversationLock {
  id     String @id @default(uuid()) @db.Uuid
  convId String @map("conversID") @db.Uuid
  /// Compte proprietaire du verrou. Un seul verrou par (conversation, compte) :
  /// c'est entre appareils d'un meme compte que la main se passe.
  userId String @map("alanyaID") @db.Uuid

  conv Conversation @relation(fields: [convId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Appareil qui detient le verrou. Sans cle etrangere : `Appareil.idAgent`
  /// n'est pas unique, et la ligne d'appareil peut disparaitre sans que le
  /// verrou doive tomber avec elle.
  appareilId Int     @map("appareilID")
  /// Nom affiche du detenteur, fige a la pose. Les autres appareils doivent
  /// pouvoir dire QUI a la main sans requeter le registre a chaque affichage,
  /// et le nom reste juste meme si l'appareil est retire ensuite.
  detenteur  String? @db.VarChar(80)

  lockedAt  DateTime @default(now()) @map("locked_at") @db.Timestamptz
  /// Peremption. L'appareil detenteur la repousse tant qu'il est connecte ; a
  /// defaut le verrou tombe tout seul, sinon une fermeture brutale laisserait
  /// la conversation reservee pour toujours.
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@unique([convId, userId])
  @@index([userId])
  @@index([expiresAt])
  @@map("conversation_lock")
}

// ---------------------------------------------------------------------------
// USER_ACCESS (journal de connexions) — table du référentiel, ajoutée
// ---------------------------------------------------------------------------

/// Relevés de position d'un utilisateur, alimentés par le MOBILE uniquement.
///
/// ⚠️ UNE LIGNE PAR RELEVÉ — règle changée le 11/08/2026. Le téléphone relève sa
/// position toutes les cinq minutes, et CHAQUE relevé est conservé tel quel,
/// qu'il ait bougé ou non.
///
/// La version précédente ne créait une ligne qu'en cas de déplacement de plus de
/// 50 m et repoussait sinon le `collectTime` existant : une ligne décrivait donc
/// un LIEU. C'était économe, mais l'information était perdue à l'écriture —
/// impossible ensuite de distinguer « présent en continu » de « passé deux fois
/// au même endroit », ni de savoir si le téléphone relevait encore.
///
/// Le regroupement en lieux et le calcul des durées sont désormais une affaire
/// de LECTURE, faite à l'analyse sur des données complètes.
///
/// ⚠️ Environ 288 lignes par jour et par utilisateur suivi : prévoir une purge
/// par ancienneté quand le parc grandira. L'index `(user_id, collect_time)` la
/// servira aussi bien qu'il sert la lecture.
///
/// La table existait déjà en production sans figurer ici — Prisma ne pouvait
/// donc pas l'écrire. Migration : `prisma/manual/2026-08_geo_positions.sql`.
model Geo {
  idGeo BigInt @id @default(autoincrement()) @map("idGeo")
  /// `Decimal(10,7)` : environ un centimètre de résolution. Bien au-delà de la
  /// précision d'un GPS de téléphone, mais c'est le type déjà en base.
  lat   Decimal @db.Decimal(10, 7)
  lon   Decimal @db.Decimal(10, 7)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Heure du DERNIER relevé ayant confirmé cette position.
  collectTime DateTime @map("collect_time") @db.Timestamptz

  /// Sert la seule lecture chaude : la dernière position connue d'un
  /// utilisateur, consultée à chaque relevé.
  @@index([userId, collectTime], map: "geo_user_id_collect_time_idx")
  @@map("geo")
}

/// Décision de l'utilisateur sur le suivi de sa position.
///
/// ⚠️ Elle DOIT remonter au serveur : l'écran de divulgation promet que
/// l'entreprise sera informée si le suivi n'est pas actif. Tant que la décision
/// ne vivait que dans les préférences du téléphone, cette phrase était une
/// promesse que rien ne tenait.
///
/// Table à NOUS, pas une colonne sur `users` : le référentiel équipe décrit
/// `users`, et y ajouter notre information serait un écart de plus à défendre à
/// chaque harmonisation.
///
/// Migration : `prisma/manual/2026-08_geo_consentement.sql`.
model GeoConsentement {
  /// L'utilisateur EST la clé : une seule décision courante par compte, la
  /// ré-affirmer écrase la précédente. Aucun historique — ce qui compte est
  /// l'état actuel, un journal des refus successifs n'aiderait personne.
  userId   String   @id @map("user_id") @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accepte  Boolean
  decideAt DateTime @default(now()) @map("decide_at") @db.Timestamptz

  @@map("geo_consentement")
}

model UserAccess {
  idLogin   BigInt   @id @default(autoincrement())
  alanyaId  String   @map("alanyaID") @db.Uuid
  user      User     @relation(fields: [alanyaId], references: [id], onDelete: Cascade)
  device    String   @default("INDEFINI") @db.VarChar(255)
  dateLogin DateTime @default(now()) @db.Timestamptz
  ipAdress  String   @default("INDEFINI") @db.VarChar(255)
  osSystem  String   @default("INDEFINI") @map("os_system") @db.VarChar(255)

  /// Répond directement à la lecture de l'historique d'un compte
  /// (filtre sur l'utilisateur, tri par date).
  @@index([alanyaId, dateLogin(sort: Desc)], map: "userAccess_alanyaID_dateLogin_idx")
  /// Conservé pour une purge par ancienneté.
  @@index([dateLogin])
  @@map("userAccess")
}

// ---------------------------------------------------------------------------
// CALL_HISTORY (appels 1-à-1) — table du référentiel, ajoutée.
// Nos tables `calls` / `call_participants` (appels de groupe) restent en plus.
// ---------------------------------------------------------------------------

model CallHistory {
  idCall       BigInt    @id @default(autoincrement()) @map("IDcall")
  idCaller     String    @db.Uuid
  caller       User      @relation("CallCaller", fields: [idCaller], references: [id], onDelete: Cascade)
  idReceiver   String    @db.Uuid
  receiver     User      @relation("CallReceiver", fields: [idReceiver], references: [id], onDelete: Cascade)
  type         Int       @default(0) @db.SmallInt // 0=audio 1=video
  status       Int       @default(0) @db.SmallInt // 0=missed 1=answered 2=rejected
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startTime    DateTime? @map("start_time") @db.Timestamptz
  duree        Int       @default(0)
  mode         Int?      @db.SmallInt
  ip           String?   @db.VarChar(45)
  /// « relay » (acheminé par Coturn) ou « p2p » (direct). Nul tant que
  /// l'information n'est pas remontée par le client.
  transmission String?   @db.VarChar(10)

  @@index([idCaller, createdAt])
  @@index([idReceiver, createdAt])
  @@map("callHistory")
}

