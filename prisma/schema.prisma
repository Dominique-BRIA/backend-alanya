// Schéma de données Alanya — PostgreSQL + Prisma
// Dérivé du cahier des charges (Groupe Alanya II), enrichi : numéro public 6 chiffres,
// statuts éphémères (stories) et IA conversationnelle (Gemini).
//
// Conventions (cf. cahier des charges) :
//  - Clés primaires en UUID
//  - Dates en TIMESTAMPTZ (DateTime @db.Timestamptz)
//  - Mots de passe hachés (BCrypt) avant insertion
//  - Index sur les colonnes fréquemment filtrées

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH & COMPTE
// ---------------------------------------------------------------------------

model User {
  // Colonnes physiques alignées sur le référentiel équipe (alanya.sql).
  // Les noms de champ Prisma restent inchangés → code applicatif et contrat API intacts ;
  // seuls les noms de colonnes Postgres changent via @map (UUID conservés).
  id            String   @id @default(uuid()) @db.Uuid @map("alanyaID")
  email         String   @unique
  passwordHash  String?  @map("password")
  publicNumber  String   @unique @db.VarChar(8) @map("alanyaPhone")
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime @updatedAt @db.Timestamptz

  // --- F1 : Inscription avec pays ---
  nom           String?  @db.VarChar(100)
  idPays        Int?     @db.SmallInt @map("idPays")
  pays          Pays?    @relation(fields: [idPays], references: [idPays])

  // --- F3 : Type de compte ---
  typeCompte    Int      @default(0) @db.SmallInt @map("type_compte")

  // --- F4 : Profil fusionné (anciennement dans Profile) ---
  pseudo        String?  @db.VarChar(100)     @map("pseudo")
  avatarUrl     String?  @db.VarChar(2048)    @map("avatar_url")
  statusMsg     String?  @db.VarChar(255)     @map("status_msg")
  lastSeen      DateTime? @db.Timestamptz     @map("last_seen")

  // --- F5 : Présence en ligne ---
  isOnline      Int      @default(0) @db.SmallInt @map("is_online")

  // --- Confidentialité (Phase 3.1) ---
  // readReceipts : 1 = envoie/reçoit les confirmations de lecture, 0 = off.
  // lastSeenVisibility : 0 = personne, 1 = mes contacts, 2 = tout le monde.
  readReceipts       Int  @default(1) @db.SmallInt @map("read_receipts")
  lastSeenVisibility Int  @default(2) @db.SmallInt @map("last_seen_visibility")

  // --- F6 : Exclusion de compte ---
  exclus        Int      @default(0) @db.SmallInt
  excludeAt     DateTime? @db.Timestamptz     @map("exclude_at")
  excludeReason String?  @db.VarChar(255)     @map("exclude_reason")

  // --- F7 : Biométrie / état d'appel / device (colonnes du référentiel) ---
  inCall        Int      @default(0) @db.SmallInt @map("in_call")
  biometric     Int      @default(0) @db.SmallInt
  fcmToken      String?  @db.VarChar(255)     @map("fcm_token")
  deviceId      String?  @db.VarChar(255)     @map("device_ID")
  resetOtp      String?  @db.VarChar(6)       @map("reset_otp")
  resetOtpExpiresAt DateTime? @db.Timestamptz @map("reset_otp_expires_at")

  refreshTokens    RefreshToken[]
  contacts         Contact[]       @relation("UserContacts")
  contactOf        Contact[]       @relation("ContactOf")
  participations   Participant[]
  sentMessages     Message[]       @relation("MessageSender")
  ownedMedia       MediaFile[]
  statuses         Status[]
  statusViews      StatusView[]
  callsInitiated   Call[]          @relation("CallInitiator")
  callParticipants CallParticipant[]
  aiThreads        AiThread[]
  pushDevices      PushDevice[]
  messageHides     MessageHide[]
  messageReactions MessageReaction[]
  messageStars     MessageStar[]

  // --- Nouvelles relations (schéma PDF) ---
  organizedMeetings     Meeting[]            @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[] @relation("MeetingParticipantUser")
  blockedUsers          Blocked[]            @relation("BlockOwner")
  blockedByUsers        Blocked[]            @relation("BlockedUser")

  // --- Relations vers les nouvelles tables du référentiel ---
  accessLogs            UserAccess[]
  callsMade             CallHistory[]        @relation("CallCaller")
  callsReceived         CallHistory[]        @relation("CallReceiver")
  reservedPhones        ReservedAlanyaPhone[]

  @@index([publicNumber])
  @@map("users")
}

// Jetons FCM (Firebase Cloud Messaging) pour notifications push mobile/web.
model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @db.VarChar(512)
  platform  String   @db.VarChar(16) // android | ios | web
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([userId])
  @@map("push_devices")
}

// Codes de vérification email (OTP 6 chiffres) — envoyés via Firebase/email
model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  codeHash  String // hash du code OTP à 6 chiffres (jamais en clair)
  expiresAt DateTime @db.Timestamptz
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([email])
  @@map("email_verifications")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String // hash du refresh token
  expiresAt DateTime @db.Timestamptz
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@map("refresh_tokens")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid @map("idPrefContact")
  userId    String   @db.Uuid @map("alanyaID")
  contactId String   @db.Uuid @map("idFriend")
  user      User     @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contact   User     @relation("ContactOf", fields: [contactId], references: [id], onDelete: Cascade)
  alias     String?  @db.VarChar(100) // extra local : nom donné par l'utilisateur dans son répertoire
  isBlocked Boolean  @default(false)  // extra local
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")

  @@unique([userId, contactId])
  @@index([userId])
  @@map("preferredContact")
}

// ---------------------------------------------------------------------------
// MESSAGERIE
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid @map("conversID")
  isGroup   Boolean  @default(false)
  name      String?  @db.VarChar(150) @map("GroupName") // nom du groupe (null pour les conversations directes)
  avatarUrl String?  @map("groupPhoto")
  createdAt DateTime @default(now()) @db.Timestamptz // extra local
  updatedAt DateTime @updatedAt @db.Timestamptz       // extra local

  participants Participant[]
  messages     Message[]

  // --- F11 : Dernier message dénormalisé ---
  lastMessage        String?   @db.Text
  lastMessageAt      DateTime? @db.Timestamptz
  lastMessageSenderID String?  @db.Uuid
  lastMessageType    Int?      @db.SmallInt
  lastMessageStatus  Int?      @db.SmallInt

  // Message épinglé (partagé à toute la conversation). Null = aucun. Pas de FK :
  // si le message est supprimé pour tous il reste consultable (deletedAt), et on
  // filtre à la lecture au besoin.
  pinnedMessageId String? @db.Uuid @map("pinned_message_id")

  // Messages éphémères : durée de vie (en secondes) des NOUVEAUX messages.
  // 0 = désactivé. Les valeurs usuelles : 86400 (24h), 604800 (7j), 7776000 (90j).
  disappearingSeconds Int @default(0) @map("disappearing_seconds")

  @@map("conversation")
}

enum ParticipantRole {
  MEMBER
  ADMIN
}

model Participant {
  id       String          @id @default(uuid()) @db.Uuid
  convId   String          @db.Uuid @map("conversID")
  userId   String          @db.Uuid @map("alanyaID")
  conv     Conversation    @relation(fields: [convId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ParticipantRole @default(MEMBER) // extra local
  joinedAt DateTime        @default(now()) @db.Timestamptz
  // Pointeur de lecture pour calculer les non-lus (extra local)
  lastReadAt DateTime?     @db.Timestamptz

  // --- F8 : Épingler ---
  isPinned  Int  @default(0) @db.SmallInt

  // --- F9 : Archiver ---
  isArchived Int @default(0) @db.SmallInt

  // --- F10 : Compteur de non-lus ---
  unreadCount Int @default(0) @db.SmallInt

  @@unique([convId, userId])
  @@index([userId])
  @@map("conv_participants")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO // message vocal
  VIDEO
  SYSTEM
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Message {
  id        String        @id @default(uuid()) @db.Uuid @map("msgID")
  convId    String        @db.Uuid @map("conversationID")
  senderId  String        @db.Uuid @map("senderID")
  conv      Conversation  @relation(fields: [convId], references: [id], onDelete: Cascade)
  sender    User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content   String?       // texte (null pour médias purs)
  type      MessageType   @default(TEXT)
  status    MessageStatus @default(SENT)
  replyToId String?       @db.Uuid @map("replyToID")
  replyTo   Message?      @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[]     @relation("MessageReplies")
  media     MediaFile[]
  createdAt DateTime      @default(now()) @db.Timestamptz @map("sendAt")
  editedAt  DateTime?     @db.Timestamptz
  // Message éphémère : instant d'expiration (null = permanent). Purgé après.
  expiresAt DateTime?     @db.Timestamptz @map("expires_at")
  deletedAt DateTime?     @db.Timestamptz // extra local (le réf. utilise isDeleted/deletedForID)
  hides     MessageHide[]
  reactions MessageReaction[]
  stars     MessageStar[]

  @@index([convId, createdAt])
  @@index([senderId])
  @@map("message")
}

// Messages favoris (étoile). Privé à chaque utilisateur (comme WhatsApp) :
// une ligne = « cet utilisateur a mis ce message en favori ». onDelete Cascade.
model MessageStar {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid @map("message_id")
  userId    String   @db.Uuid @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_stars")
}

// Réactions emoji (extra local). Une seule réaction par utilisateur et par
// message (@@unique) : réagir à nouveau remplace l'emoji, réagir avec le même
// emoji le retire (géré côté handler). onDelete: Cascade nettoie automatiquement.
model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid @map("message_id")
  userId    String   @db.Uuid @map("user_id")
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

// Suppression « pour moi » : enregistre qu'un utilisateur a masqué un message
// de sa vue (les autres participants le voient toujours). @@unique empêche les
// doublons ; onDelete: Cascade nettoie automatiquement si l'utilisateur ou le
// message est supprimé.
model MessageHide {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  messageId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([userId, messageId])
  @@index([userId])
  @@map("message_hides")
}

// ---------------------------------------------------------------------------
// MÉDIAS (binaires sur disque, métadonnées en base)
// ---------------------------------------------------------------------------

model MediaFile {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @db.Uuid
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messageId    String?  @db.Uuid
  message      Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  filename     String
  mimeType     String
  sizeBytes    Int
  url          String // chemin/URL d'accès (le binaire est stocké hors BD)
  thumbnailUrl String?
  durationMs   Int? // pour audio/vidéo (messages vocaux, appels)
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([ownerId])
  @@index([messageId])
  @@map("media_files")
}

// ---------------------------------------------------------------------------
// STATUTS (stories éphémères, 24 h)
// ---------------------------------------------------------------------------

enum StatusType {
  TEXT
  IMAGE
  VIDEO
}

model Status {
  id        String       @id @default(uuid()) @db.Uuid @map("ID")
  userId    String       @db.Uuid @map("alanyaID")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      StatusType   @default(TEXT)
  text      String?      @db.VarChar(700)
  mediaUrl  String?
  bgColor   String?      @db.VarChar(9) @map("backgroundColor") // couleur de fond pour les statuts texte
  createdAt DateTime     @default(now()) @db.Timestamptz
  expiresAt DateTime     @db.Timestamptz @map("expiredAt") // createdAt + 24 h

  views StatusView[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("statut")
}

model StatusView {
  id       String   @id @default(uuid()) @db.Uuid
  statusId String   @db.Uuid @map("statutID")
  viewerId String   @db.Uuid @map("alanyaID")
  status   Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now()) @db.Timestamptz @map("seenAt")

  @@unique([statusId, viewerId])
  @@map("statut_views")
}

// ---------------------------------------------------------------------------
// APPELS (WebRTC : signaling + métadonnées)
// ---------------------------------------------------------------------------

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED
  REJECTED
}

model Call {
  id        String     @id @default(uuid()) @db.Uuid
  initiatorId String   @db.Uuid
  initiator User       @relation("CallInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  convId    String?    @db.Uuid
  type      CallType   @default(AUDIO)
  status    CallStatus @default(RINGING)
  startedAt DateTime   @default(now()) @db.Timestamptz
  answeredAt DateTime? @db.Timestamptz
  endedAt   DateTime?  @db.Timestamptz

  participants CallParticipant[]

  @@index([initiatorId])
  @@map("calls")
}

model CallParticipant {
  id       String    @id @default(uuid()) @db.Uuid
  callId   String    @db.Uuid
  userId   String    @db.Uuid
  call     Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime? @db.Timestamptz
  leftAt   DateTime? @db.Timestamptz

  @@unique([callId, userId])
  @@map("call_participants")
}

// ---------------------------------------------------------------------------
// IA CONVERSATIONNELLE (Gemini)
// ---------------------------------------------------------------------------

enum AiRole {
  USER
  MODEL
}

model AiThread {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?     @db.VarChar(150)
  createdAt DateTime    @default(now()) @db.Timestamptz
  updatedAt DateTime    @updatedAt @db.Timestamptz

  messages AiMessage[]

  @@index([userId])
  @@map("ai_threads")
}

model AiMessage {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @db.Uuid
  thread    AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      AiRole
  content   String
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([threadId, createdAt])
  @@map("ai_messages")
}

// ===========================================================================
// NOUVEAUX MODÈLES — Schéma PDF cible
// ===========================================================================

// ---------------------------------------------------------------------------
// PAYS (référentiel pays — source de vérité pour les indicatifs & fuseaux)
// ---------------------------------------------------------------------------

model Pays {
  idPays          Int    @id @default(autoincrement()) @db.SmallInt  // MySQL smallint → PG SMALLINT
  libelle         String @db.VarChar(200)                            // MySQL varchar(200)
  prefix          String @db.VarChar(10)                             // indicatif téléphonique (+237, +33…)
  timeZone        String @db.VarChar(200)                            // ex: "Africa/Douala"
  decalageHoraire Int

  users           User[]

  @@map("pays")
}

// ---------------------------------------------------------------------------
// MEETINGS (réunions audio/vidéo planifiées)
// ---------------------------------------------------------------------------

model Meeting {
  idMeeting   Int      @id @default(autoincrement())            // MySQL int → PG INTEGER
  idOrganiser String   @db.Uuid
  organiser   User     @relation("MeetingOrganizer", fields: [idOrganiser], references: [id], onDelete: Cascade)
  start_time  DateTime @db.Timestamptz                          // MySQL datetime → PG TIMESTAMPTZ
  duree       Int                                              // MySQL int → PG INTEGER (secondes)
  objet       String   @db.VarChar(200)                        // MySQL varchar(200)
  room        String   @db.VarChar(200)                        // MySQL varchar(200)
  isEnd       Int      @default(0) @db.SmallInt                // MySQL tinyint → PG SMALLINT
  type_media  Int      @db.SmallInt                            // MySQL tinyint → PG SMALLINT (1=audio, 2=vidéo)

  participants MeetingParticipant[]

  @@index([idOrganiser])
  @@map("meeting")
}

model MeetingParticipant {
  ID            Int       @id @default(autoincrement())        // MySQL int → PG INTEGER
  idMeeting     Int                                           // MySQL int → PG INTEGER
  meeting       Meeting   @relation(fields: [idMeeting], references: [idMeeting], onDelete: Cascade)
  IDparticipant String    @db.Uuid
  user          User      @relation("MeetingParticipantUser", fields: [IDparticipant], references: [id], onDelete: Cascade)
  status        Int       @default(0) @db.SmallInt             // MySQL tinyint → PG SMALLINT (0=invité, 1=accepté, 2=décliné)
  start_time    DateTime? @db.Timestamptz                      // MySQL datetime → PG TIMESTAMPTZ
  connecte      Int       @default(0) @db.SmallInt             // MySQL tinyint → PG SMALLINT (0=déconnecté, 1=connecté)
  duree         Int?                                           // MySQL int → PG INTEGER (secondes)

  @@unique([idMeeting, IDparticipant])
  @@index([IDparticipant])
  @@map("participant")
}

// ---------------------------------------------------------------------------
// BLOCKED (utilisateurs bloqués — indépendant de Contact.isBlocked)
// ---------------------------------------------------------------------------

model Blocked {
  idBlock       Int      @id @default(autoincrement())         // MySQL int → PG INTEGER
  alanyaID      String   @db.Uuid
  owner         User     @relation("BlockOwner", fields: [alanyaID], references: [id], onDelete: Cascade)
  idCallerBlock String   @db.Uuid
  blockedUser   User     @relation("BlockedUser", fields: [idCallerBlock], references: [id], onDelete: Cascade)
  dateBlock     DateTime @default(now()) @db.Timestamptz       // MySQL datetime → PG TIMESTAMPTZ

  @@unique([alanyaID, idCallerBlock])
  @@index([alanyaID])
  @@map("blocked")
}

// ---------------------------------------------------------------------------
// USER_ACCESS (journal de connexions) — table du référentiel, ajoutée
// ---------------------------------------------------------------------------

model UserAccess {
  idLogin  BigInt   @id @default(autoincrement())
  alanyaId String   @db.Uuid @map("alanyaID")
  user     User     @relation(fields: [alanyaId], references: [id], onDelete: Cascade)
  device   String   @default("INDEFINI") @db.VarChar(255)
  dateLogin DateTime @default(now()) @db.Timestamptz
  ipAdress String   @default("INDEFINI") @db.VarChar(255)
  osSystem String   @default("INDEFINI") @db.VarChar(255) @map("os_system")

  @@index([dateLogin])
  @@map("userAccess")
}

// ---------------------------------------------------------------------------
// CALL_HISTORY (appels 1-à-1) — table du référentiel, ajoutée.
// Nos tables `calls` / `call_participants` (appels de groupe) restent en plus.
// ---------------------------------------------------------------------------

model CallHistory {
  idCall     BigInt   @id @default(autoincrement()) @map("IDcall")
  idCaller   String   @db.Uuid
  caller     User     @relation("CallCaller", fields: [idCaller], references: [id], onDelete: Cascade)
  idReceiver String   @db.Uuid
  receiver   User     @relation("CallReceiver", fields: [idReceiver], references: [id], onDelete: Cascade)
  type       Int      @default(0) @db.SmallInt // 0=audio 1=video
  status     Int      @default(0) @db.SmallInt // 0=missed 1=answered 2=rejected
  createdAt  DateTime @default(now()) @db.Timestamptz @map("created_at")
  startTime  DateTime? @db.Timestamptz @map("start_time")
  duree      Int      @default(0)
  mode       Int?     @db.SmallInt
  ip         String?  @db.VarChar(45)

  @@index([idCaller, createdAt])
  @@index([idReceiver, createdAt])
  @@map("callHistory")
}

// ---------------------------------------------------------------------------
// RESERVED_ALANYA_PHONE (numéros réservés admin) — table du référentiel, ajoutée
// ---------------------------------------------------------------------------

model ReservedAlanyaPhone {
  id             Int      @id @default(autoincrement())
  phoneCanonical String   @unique @db.VarChar(8) @map("phone_canonical")
  label          String   @db.VarChar(100)
  createdBy      String?  @db.Uuid @map("created_by")
  creator        User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @db.Timestamptz @map("created_at")

  @@map("reserved_alanya_phone")
}
